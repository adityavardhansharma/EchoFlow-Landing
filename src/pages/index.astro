---
import Home from '../layouts/Home.astro';
import Hero from '../components/v8/Hero.astro';
import Row from '../components/v8/Row.astro';
import Myth from '../components/v8/Myth.astro';
import Configure from '../components/v8/Configure.astro';
import Exchanges from '../components/v8/Exchanges.astro';
import Close from '../components/v8/Close.astro';
import Footer from '../components/v8/Footer.astro';
import { pages } from '../lib/seo';

const seo = pages.home;
---
<Home seo={seo}>
  <main id="top">
    <Hero />
    <Row />
    <Myth />
    <Configure />
    <Exchanges />
    <Close />
  </main>
  <Footer />
</Home>

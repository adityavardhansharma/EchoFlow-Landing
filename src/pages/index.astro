---
import Home from '../layouts/Home.astro';
import Hero from '../components/v9/Hero.astro';
import Walls from '../components/v9/Walls.astro';
import Ports from '../components/v9/Ports.astro';
import Route from '../components/v9/Route.astro';
import Close from '../components/v9/Close.astro';
import OwnerStills from '../components/v9/OwnerStills.astro';
import Footer from '../components/v9/Footer.astro';
import { pages } from '../lib/seo';

const seo = pages.home;
---
<Home seo={seo}>
  <main id="top">
    <Hero />
    <Walls />
    <Ports />
    <Route />
    <OwnerStills />
    <Close />
  </main>
  <Footer />
</Home>

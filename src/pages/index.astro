---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Panel from '../components/Panel.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import ReaderBand from '../components/ReaderBand.astro';
import ArtifactsPanel from '../components/ArtifactsPanel.astro';
import ThemesPanel from '../components/ThemesPanel.astro';
import PrivacyPanel from '../components/PrivacyPanel.astro';
import Finale from '../components/Finale.astro';
import Footer from '../components/Footer.astro';
import { pages } from '../lib/seo';

const seo = pages.home;
---
<Base seo={seo}>
  <Nav />
  <main>
    <Hero />

    <header class="tour-head" id="tour">
      <div class="wrap" data-reveal>
        <h2 class="h2">Take the tour.</h2>
        <p class="muted">One idea per stop. By the last one you'll know exactly what's on your phone.</p>
      </div>
    </header>

    <div class="tour wrap-wide">
      <Panel
        id="models"
        num="01"
        kicker="Models"
        title="Bring any brain."
        body="OpenRouter's 400-model catalog, direct keys for OpenAI, Claude, Gemini, Grok, Cerebras, xAI and Sarvam — and real on-device models: download Gemma, Qwen or DeepSeek in-app, search Hugging Face's mobile builds, or import your own GGUF. Switch mid-conversation whenever one of them disappoints you."
        facts={[
          'On-device: LiteRT catalog + GGUF import',
          'Your keys go straight to the provider',
          'Swap models mid-chat',
        ]}
        img="/brand/v3/10-chat-on-device-model.jpg"
        alt="EchoFlow chat running a local model fully on-device"
        tint="var(--c-ocean)"
      />

      <Panel
        id="capabilities"
        num="02"
        kicker="The plus button"
        title="Superpowers, filed under +."
        body="Everything bigger than a message lives one tap away: attach images and PDFs, or send real work off to run on its own."
        facts={[
          '<b>Web search</b> — free for everyone, no key',
          '<b>Deep Research</b> — background runs, cited reports',
          '<b>Data Agent</b> — structured answers, not prose',
          '<b>Echo Agents</b> — a model with its own tools',
        ]}
        img="/brand/v3/03-attach-and-capabilities-menu.jpg"
        alt="EchoFlow attach and capabilities menu: web search, deep research, artifact, data agent"
        tint="#41556e"
        reverse
      />

      <ReaderBand />

      <div class="tour-duo">
        <Panel
          id="dictation"
          num="04"
          kicker="Dictation"
          title="Stop typing. Say it."
          body="Tap the mic and talk — a live waveform takes over the composer and your words land as editable text, in every chat and project. Dictation has its own model picker and its own key, independent of whatever's answering you."
          facts={[
            'GPT Transcribe · Grok · Nemotron · Chirp, via OpenRouter',
            'Or Saaras v4 on a Sarvam key — 22 Indian languages, auto-detected',
          ]}
          img="/brand/v3/04-voice-mode-dark-theme.jpg"
          alt="EchoFlow dictation waveform in the dark theme"
          tint="var(--c-ocean)"
          dark
          compact
        />

        <Panel
          id="imagine"
          num="05"
          kicker="Imagine"
          title="Picture something."
          body="A second surface just for making things. Describe an image and edit it conversationally — “make the sky purple” — or ask for video and let it render with the app closed."
          facts={[
            'Image and video modes',
            'A contact sheet, not a chat log',
          ]}
          img="/brand/v3/05-imagine-image-generation.jpg"
          alt="EchoFlow Imagine surface for image and video generation"
          tint="var(--c-lavender)"
          compact
        />
      </div>

      <Panel
        id="network"
        num="06"
        kicker="Your network"
        title="Your PC thinks. Your phone talks."
        body="Point EchoFlow at the Ollama or LM Studio box on your desk and answers stream to your phone over Wi-Fi, token by token. No cloud, no key, no bill — the model never leaves your house."
        facts={[
          'Ollama · LM Studio · Jan · vLLM',
          'Any OpenAI-compatible endpoint',
          'You pick which models show up',
        ]}
        img="/brand/v3/09-custom-api-endpoints.jpg"
        alt="EchoFlow custom API endpoint settings with Ollama and OpenAI-compatible providers"
        tint="#456a8e"
        reverse
      />

      <Panel
        id="projects"
        num="07"
        kicker="Projects"
        title="Give your chats a home."
        body="A project holds files and instructions, and every chat inside starts already knowing them. Twelve PDFs about one warranty claim? Attach them once, argue as long as you need."
        facts={[
          'Files read by the on-device engine',
          'Instructions set the tone once',
          'Dictate inside project chats too',
        ]}
        tint="var(--c-rose)"
      >
        <div class="duo">
          <PhoneFrame tone="light" class="p-phone duo-a">
            <img src="/brand/v3/06-projects-list.jpg" alt="EchoFlow projects list" width="724" height="1568" loading="lazy" decoding="async" />
          </PhoneFrame>
          <PhoneFrame tone="light" class="p-phone duo-b">
            <img src="/brand/v3/07-project-detail.jpg" alt="EchoFlow project with context files, instructions and conversations" width="724" height="1568" loading="lazy" decoding="async" />
          </PhoneFrame>
        </div>
      </Panel>

      <Panel
        id="drawer"
        num="08"
        kicker="The drawer"
        title="Everything, one swipe away."
        body="Pinned chats, full-text search, Projects, the Artifact Gallery — the whole app hangs off one swipe from the edge."
        facts={[
          'Pin the conversations that matter',
          'Search everything you\u2019ve ever said',
          'Projects and Artifacts, one tap deep',
        ]}
        img="/brand/v3/01-navigation-drawer-conversations.jpg"
        alt="EchoFlow navigation drawer with Projects, Artifacts and pinned conversations"
        tint="var(--c-wall)"
        reverse
      />

      <ArtifactsPanel />

      <ThemesPanel />
    </div>

    <PrivacyPanel />
    <Finale />
  </main>
  <Footer />

  <script>
    // Gentle scroll reveal. `.js` on <html> gates the hidden state, so nothing
    // is invisible without JavaScript.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.18 },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  </script>
</Base>

<style>
  .tour-head { padding-block: clamp(3.5rem, 7vw, 5.5rem) clamp(1.5rem, 3vw, 2.5rem);
    text-align: center; }
  .tour-head p { margin-top: .9rem; }
  .tour { display: grid; gap: clamp(1.2rem, 2.5vw, 2rem);
    padding-bottom: clamp(3rem, 6vw, 5rem); }

  .tour-duo { display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(1.2rem, 2.5vw, 2rem); align-items: stretch; }
  @media (max-width: 880px) { .tour-duo { grid-template-columns: 1fr; } }

  .duo { display: flex; align-items: center; justify-content: center; }
  .duo :global(.p-phone) { width: min(225px, 42vw); }
  .duo :global(.duo-a) { transform: rotate(-4deg) translateX(8%); z-index: 1; }
  .duo :global(.duo-b) { transform: rotate(3deg) translateX(-8%) translateY(6%); z-index: 2; }
</style>

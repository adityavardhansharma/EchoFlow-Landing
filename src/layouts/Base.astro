---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'EchoFlow — every model, made yours',
  description = 'A beautiful Android chat app for OpenRouter. Bring your own key, talk to any model, watch it reason in real time, and keep every conversation on your phone — no account, nothing kept on a server.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08111f" />
    <link rel="icon" type="image/png" href="/brand/echoflow-mark.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/brand/shot-home-ocean.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script>
      // Point every download button ([data-apk]) at the latest GitHub release's APK
      // asset. Falls back to the /releases/latest page (the hardcoded href) if the
      // API call fails or no .apk asset is found.
      (async () => {
        const links = document.querySelectorAll('a[data-apk]');
        if (!links.length) return;
        try {
          const res = await fetch('https://api.github.com/repos/adityavardhansharma/EchoFlow/releases/latest', {
            headers: { Accept: 'application/vnd.github+json' },
          });
          if (!res.ok) return;
          const data = await res.json();
          const apk = (data.assets || []).find((a) => a.name?.toLowerCase().endsWith('.apk'));
          if (apk?.browser_download_url) {
            links.forEach((a) => a.setAttribute('href', apk.browser_download_url));
          }
          if (data.tag_name) {
            document.querySelectorAll('[data-apk-version]').forEach((el) => {
              el.textContent = data.tag_name;
            });
          }
        } catch {
          /* keep the releases-page fallback href */
        }
      })();
    </script>
  </body>
</html>

---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import {
  SITE_NAME,
  absoluteImage,
  absoluteUrl,
  softwareAppJsonLd,
  websiteJsonLd,
  type PageSEO,
} from '../lib/seo';

interface Props {
  seo?: PageSEO;
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  seo,
  title = seo?.title ?? 'EchoFlow — Open-Source AI App for Android',
  description = seo?.description ?? '',
  ogImage = seo?.ogImage ?? '/brand/shot-home-ocean.jpg',
  canonicalPath = seo?.path ?? '/',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const canonical = absoluteUrl(canonicalPath);
const image = absoluteImage(ogImage);
const extraLd = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const structuredData = [websiteJsonLd(), softwareAppJsonLd(), ...extraLd];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6f2e6" />
    <link rel="icon" type="image/png" href="/brand/echoflow-mark.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="EchoFlow — AI app for Android screenshot" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=general-sans@400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot />
    <SpeedInsights />
    <script>
      import { RELEASES_URL, fetchLatestRelease, findApkAsset } from '../lib/releases';

      const links = document.querySelectorAll('a[data-apk]');
      let apkUrlPromise;

      async function getLatestApkUrl() {
        if (!apkUrlPromise) {
          apkUrlPromise = fetchLatestRelease().then((release) => {
            const apk = findApkAsset(release);
            if (!apk?.browser_download_url) {
              throw new Error('No APK asset found in latest GitHub release');
            }

            links.forEach((link) => {
              link.setAttribute('href', apk.browser_download_url);
              link.setAttribute('download', '');
            });

            if (release.tag_name) {
              document.querySelectorAll('[data-apk-version]').forEach((el) => {
                el.textContent = release.tag_name;
              });
            }

            return apk.browser_download_url;
          });
        }

        try {
          return await apkUrlPromise;
        } catch (error) {
          apkUrlPromise = undefined;
          throw error;
        }
      }

      links.forEach((link) => {
        link.addEventListener('click', async (event) => {
          if (link.getAttribute('href') !== RELEASES_URL) return;

          event.preventDefault();
          link.setAttribute('aria-busy', 'true');

          try {
            window.location.href = await getLatestApkUrl();
          } catch {
            link.removeAttribute('aria-busy');
          }
        });
      });

      if (links.length) {
        getLatestApkUrl().catch(() => {
          links.forEach((link) => {
            link.removeAttribute('aria-busy');
          });
        });
      }
    </script>
  </body>
</html>

---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';
interface Props { title?: string; description?: string; }
const {
  title = 'EchoFlow — every model, made yours',
  description = 'A beautiful Android chat app for OpenRouter. Bring your own key, talk to any model, watch it reason in real time, and keep every conversation on your phone — no account, nothing kept on a server.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08111f" />
    <link rel="icon" type="image/png" href="/brand/echoflow-mark.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/brand/shot-home-ocean.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Figtree:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <SpeedInsights />
    <script>
      import { RELEASES_URL, fetchLatestRelease, findApkAsset } from '../lib/releases';

      const links = document.querySelectorAll('a[data-apk]');
      let apkUrlPromise;

      async function getLatestApkUrl() {
        if (!apkUrlPromise) {
          apkUrlPromise = fetchLatestRelease().then((release) => {
            const apk = findApkAsset(release);
            if (!apk?.browser_download_url) {
              throw new Error('No APK asset found in latest GitHub release');
            }

            links.forEach((link) => {
              link.setAttribute('href', apk.browser_download_url);
              link.setAttribute('download', '');
            });

            if (release.tag_name) {
              document.querySelectorAll('[data-apk-version]').forEach((el) => {
                el.textContent = release.tag_name;
              });
            }

            return apk.browser_download_url;
          });
        }

        try {
          return await apkUrlPromise;
        } catch (error) {
          apkUrlPromise = undefined;
          throw error;
        }
      }

      links.forEach((link) => {
        link.addEventListener('click', async (event) => {
          if (link.getAttribute('href') !== RELEASES_URL) return;

          event.preventDefault();
          link.setAttribute('aria-busy', 'true');

          try {
            window.location.href = await getLatestApkUrl();
          } catch {
            link.removeAttribute('aria-busy');
          }
        });
      });

      if (links.length) {
        getLatestApkUrl().catch(() => {
          links.forEach((link) => {
            link.removeAttribute('aria-busy');
          });
        });
      }
    </script>
  </body>
</html>

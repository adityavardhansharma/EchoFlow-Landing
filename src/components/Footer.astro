---
import Seal from './Seal.astro';
import { RELEASES_URL } from '../lib/releases';
import { alternativeLinks, featureLinks, guideLinks, resourceLinks } from '../lib/navigation';
const year = new Date().getFullYear();
---
<footer class="dark footer">
  <div class="wrap-wide foot-in">
    <div class="foot-brand">
      <a class="brand" href="/"><Seal size={32} logo fill="var(--blue-600)" /> EchoFlow</a>
      <p class="muted">An open-source, privacy-first AI app for Android. Multiple models, your own API keys, web search, file analysis, research, image generation, and optional local models.</p>
    </div>
    <nav class="cols" aria-label="Footer">
      <div>
        <h4>Features</h4>
        {featureLinks.slice(0, 6).map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div>
        <h4>More</h4>
        {featureLinks.slice(6).map((l) => <a href={l.href}>{l.label}</a>)}
        {resourceLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div>
        <h4>Comparisons</h4>
        {alternativeLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div>
        <h4>Guides</h4>
        {guideLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="https://github.com/adityavardhansharma/EchoFlow" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="mailto:echoflow@adityavs.tech">Contact</a>
      </div>
    </nav>
  </div>
  <div class="wrap-wide foot-base muted">
    <span>© {year} EchoFlow</span>
    <span>Open-source · Not affiliated with OpenRouter or any model provider</span>
    <a href="/download">Download APK</a>
  </div>
</footer>

<style>
  .footer { padding-block: 3.5rem 2rem; border-top: 1px solid var(--line-dark); }
  .foot-in { display: flex; justify-content: space-between; gap: 2.5rem; flex-wrap: wrap; }
  .brand { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--display);
    font-weight: 800; font-size: 1.2rem; letter-spacing: -.03em; }
  .foot-brand p { margin-top: .8rem; max-width: 38ch; font-size: .92rem; }
  .cols { display: flex; gap: 2.5rem; flex-wrap: wrap; }
  .cols h4 { font-family: var(--mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--on-ink-soft); margin-bottom: .9rem; font-weight: 500; }
  .cols a { display: block; color: var(--on-ink-soft); padding: .22rem 0; font-weight: 500;
    font-size: .9rem; transition: color .2s; }
  .cols a:hover { color: var(--on-ink); }
  .foot-base { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
    margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line-dark);
    font-family: var(--mono); font-size: .76rem; }
  .foot-base a { color: var(--blue-bright); }
  @media (max-width: 560px) { .cols { gap: 2rem; } }
</style>

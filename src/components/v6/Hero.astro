---
/* Hero — waterline headline. Paper above, Ocean below, meeting at half
   height; the seam cuts through the headline's second line and the letters
   change ink as they cross it. */
import { RELEASES_URL } from '../../lib/releases';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="sea" aria-hidden="true"></div>
  <a class="mark" href="/">EchoFlow</a>
  <a class="button act" href={RELEASES_URL} data-apk>Download</a>

  <div class="title">
    <h1 id="hero-title" class="copy above lines">
      <span class="line"><span data-line style="--i:0">Every model</span></span>
      <span class="line"><span data-line style="--i:1">in one app</span></span>
    </h1>
    <!-- the under-water copy is drawn, not text: it repeats the h1 for the eye only -->
    <div class="copy below lines" aria-hidden="true">
      <span class="line"><span data-line data-text="Every model" style="--i:0"></span></span>
      <span class="line"><span data-line data-text="in one app" style="--i:1"></span></span>
    </div>
  </div>

  <figure class="clip" data-rise style="--i:1">
    <video autoplay muted loop playsinline preload="metadata" poster="/brand/v5/clip-maths-poster.jpg" width="540" height="1090"
      aria-label="Screen recording: EchoFlow explaining quadratic equations with rendered maths">
      <source src="/brand/v5/clip-maths.webm" type="video/webm" />
      <source src="/brand/v5/clip-maths.mp4" type="video/mp4" />
    </video>
  </figure>

  <p class="sub" data-rise>
    EchoFlow is a free, open-source AI chat app for Android. Bring an OpenRouter key, your own
    provider keys or your PC, or run a model on the phone itself.
  </p>
</section>

<style>
  .hero {
    --fs: clamp(72px, 9vw, 140px);
    --seam: 50%;
    position: relative; height: 100svh; min-height: 560px; overflow: hidden;
    background: var(--paper);
  }
  .sea { position: absolute; left: 0; right: 0; bottom: 0; top: var(--seam); background: var(--ocean); }
  .mark { position: absolute; top: 28px; left: 28px; font-weight: 700; font-size: var(--step-lead); letter-spacing: -0.02em; text-decoration: none; z-index: 2; }
  .act { position: absolute; top: 28px; right: 28px; z-index: 2; }

  .title {
    position: absolute; left: 50%; width: min(100% - 32px, 1200px);
    top: calc(var(--seam) - var(--fs) * 1.29);
    transform: translateX(-50%);
  }
  .copy { font-size: var(--fs); font-weight: 700; line-height: 0.86; letter-spacing: -0.03em; text-align: center; margin: 0; }
  .below { position: absolute; inset: 0; }
  .above { position: relative; z-index: 1; color: var(--ocean); clip-path: inset(0 0 calc(100% - var(--fs) * 1.29) 0); }
  .below [data-text]::before { content: attr(data-text); }
  .below { color: var(--ocean-ink); clip-path: inset(calc(var(--fs) * 1.29) 0 0 0); }

  /* the real app, rising out of the water at the right */
  .clip { position: absolute; right: 8.333%; bottom: 0; width: clamp(220px, 21vw, 320px); height: calc(100% - var(--seam) - 2rem); overflow: hidden; z-index: 1; }
  .clip video { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }

  .sub {
    position: absolute; left: 28px; bottom: 40px;
    width: min(100% - 32px, 40ch); color: var(--ocean-ink);
    font-size: var(--step-lead); line-height: 1.35;
  }

  @media (max-width: 48em) {
    .hero { --fs: 15.5vw; --seam: 46%; }
    .mark, .act { top: 16px; }
    .mark { left: 16px; }
    .act { right: 16px; min-height: 2.75rem; padding: 0 1rem; }
    .sub { left: 16px; bottom: 24px; width: calc(100% - 32px); font-size: var(--step-body); }
    .clip { right: 16px; width: 40vw; height: auto; top: calc(var(--seam) + 2.5rem); bottom: 11.5rem; }
  }
</style>

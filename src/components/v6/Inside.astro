---
/* Inside — rows with margin photographs. Chapter field: Sunset. Everything
   hangs from one axis at column 5; each row carries a real screenshot at the
   right margin, deliberately unequal in size. */
const rows = [
  { title: 'Any model', body: 'OpenRouter’s whole catalogue on one key, direct keys to the big providers, or a model that never leaves the phone. Swap mid-chat.', img: '/brand/shot-cloud-models.jpg', w: 720, h: 1560, ratio: '4 / 5', size: 240, pos: '50% 8%', alt: 'EchoFlow cloud models screen with an OpenRouter key saved and a model list' },
  { title: 'Everything under +', body: 'Web search with no key, Deep Research with cited reports, artifacts that stay, a data agent that answers in tables.', img: '/brand/v3/03-attach-and-capabilities-menu.jpg', w: 945, h: 2048, ratio: '3 / 2', size: 320, pos: '50% 62%', alt: 'The plus menu: attach image or files, web search, Deep Research, artifact, data agent' },
  { title: 'Talk to it', body: 'A real voice call with a persona. It listens while it speaks, so tap anywhere to cut in.', img: '/brand/v5/voice-call.jpg', w: 720, h: 1480, ratio: '1 / 1', size: 180, pos: '50% 36%', alt: 'Voice call with the Jessica persona and a live waveform' },
  { title: 'Projects', body: 'A room that already knows your files and your rules. Every chat inside starts briefed.', img: '/brand/v3/06-projects-list.jpg', w: 945, h: 2048, ratio: '4 / 5', size: 280, pos: '50% 12%', alt: 'EchoFlow projects list with two projects' },
  { title: 'Your own PC', body: 'Point it at Ollama or LM Studio on your desk and answers stream over Wi-Fi. No cloud, no key, no bill.', img: '/brand/v3/09-custom-api-endpoints.jpg', w: 945, h: 2048, ratio: '3 / 2', size: 360, pos: '50% 34%', alt: 'Custom API endpoint screen with Ollama on localhost:11434 switched on' },
];
---
<section class="chapter f-sunset inside" id="inside" aria-labelledby="in-title">
  <div class="grid">
    <h2 id="in-title" class="head in-head" data-reveal>What’s inside</h2>
  </div>

  <ul class="rows">
    {rows.map((r) => (
      <li class="row grid" data-reveal>
        <div class="r-text">
          <h3>{r.title}</h3>
          <p>{r.body}</p>
        </div>
        <figure class="r-pic" style={`--w:${r.size}px; aspect-ratio:${r.ratio}`}>
          <img src={r.img} alt={r.alt} width={r.w} height={r.h} loading="lazy" decoding="async" style={`object-position:${r.pos}`} />
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .inside { padding-bottom: clamp(5rem, 9vw, 8rem); }
  .in-head { grid-column: 5 / 13; min-height: 52svh; display: flex; align-items: center; }
  .rows { display: grid; gap: clamp(5rem, 8vw, 7.5rem); }
  .row { align-items: start; }
  .r-text { grid-column: 5 / 10; display: grid; gap: 0.9rem; }
  .r-text h3 { font-size: clamp(28px, 3vw, 48px); }
  .r-text p { max-width: 34ch; }
  .r-pic { grid-column: 10 / 13; justify-self: end; width: min(var(--w), 100%); margin: 0; overflow: hidden; }
  .r-pic img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .row:hover .r-pic img { transform: scale(1.04); }
  }

  @media (max-width: 48em) {
    .in-head { grid-column: 1 / -1; min-height: 40svh; font-size: 11vw; }
    .rows { gap: 4rem; }
    .r-text, .r-pic { grid-column: 1 / -1; }
    .r-text h3 { font-size: 26px; }
    .r-pic { margin-top: 1.5rem; justify-self: start; }
    .row:nth-child(3n + 1) .r-pic { width: 100%; }
    .row:nth-child(3n + 2) .r-pic { width: 70%; justify-self: end; }
    .row:nth-child(3n) .r-pic { width: 55%; }
  }
</style>

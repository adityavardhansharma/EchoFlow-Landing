---
/* Close — three photographs, then a field. A gutterless strip of the app in
   three of its themes, then a Forest band whose one underlined phrase is the
   action. In the corner, the one who answers: the app's own late greeting. */
import { RELEASES_URL } from '../../lib/releases';

const strip = [
  { src: '/brand/shot-home-ocean.jpg', w: 1440, h: 3120, pos: '50% 30%', alt: 'EchoFlow home screen in the Ocean accent' },
  { src: '/brand/shot-home-lavender.jpg', w: 1440, h: 3120, pos: '50% 30%', alt: 'EchoFlow home screen in the Lavender accent' },
  { src: '/brand/v3/04-voice-mode-dark-theme.jpg', w: 945, h: 2048, pos: '50% 30%', alt: 'EchoFlow dictation in the dark theme' },
];
---
<section class="close" id="download" aria-labelledby="close-title">
  <div class="strip">
    {strip.map((p, i) => (
      <figure data-reveal style={`--i:${i}`}>
        <img src={p.src} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" style={`object-position:${p.pos}`} />
      </figure>
    ))}
  </div>

  <div class="band f-forest grid">
    <div class="b-text" data-reveal>
      <div class="statement">
        <h2 id="close-title">Free and open source.</h2>
        <p><a href={RELEASES_URL} data-apk>Download the APK</a> and keep every chat on your phone.</p>
      </div>
      <p class="b-small">
        Latest release <span data-apk-version>from GitHub</span>. No account, no sign-in.<br />
        Prefer to read it first? <a class="link" href="https://github.com/adityavardhansharma/EchoFlow" target="_blank" rel="noopener">The source is on GitHub.</a>
      </p>
    </div>
    <figure class="answerer" data-reveal style="--i:1">
      <img src="/brand/v5/greet-nightcap.jpg" width="720" height="1480" loading="lazy" decoding="async"
        alt="The app's empty chat late at night: “Nightcap? Let's make it a thought”" style="object-position: 50% 42%" />
    </figure>
  </div>
</section>

<style>
  .strip { display: grid; grid-template-columns: repeat(3, 1fr); }
  .strip figure { margin: 0; height: 40svh; min-height: 280px; overflow: hidden; }
  .strip img { width: 100%; height: 100%; object-fit: cover; }

  .band { position: relative; min-height: 44svh; padding: clamp(3rem, 6vw, 5rem) var(--margin); align-items: start; }
  .b-text { grid-column: 1 / 8; display: grid; gap: 32px; }
  .statement { font-size: var(--step-lead); font-weight: 500; letter-spacing: -0.01em; line-height: 1.25; max-width: 30ch; }
  .statement h2 { font: inherit; letter-spacing: inherit; line-height: inherit; }
  .statement a { text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 6px; transition: text-decoration-thickness var(--t-hover) ease; }
  .statement a:hover { text-decoration-thickness: 7px; }
  .b-small { font-size: var(--step-body); }
  .answerer { position: absolute; right: 40px; bottom: 40px; width: 150px; aspect-ratio: 4 / 5; margin: 0; overflow: hidden; }
  .answerer img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 48em) {
    .strip { grid-template-columns: 1fr 1fr; }
    .strip figure:first-child { grid-column: 1 / -1; height: auto; aspect-ratio: 4 / 3; }
    .strip figure { height: auto; min-height: 0; aspect-ratio: 3 / 4; }
    .b-text { grid-column: 1 / -1; padding-bottom: 9rem; }
    .answerer { right: 16px; bottom: 16px; width: 96px; }
  }
</style>

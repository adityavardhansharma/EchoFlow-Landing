---
/* How long it takes — stages as one bar. The app's progress bar enlarged to
   the page: each segment's width follows how long the stage really takes,
   each in a different accent. Chapter field: paper. */
const stages = [
  { time: 'About a minute', clause: 'First, download the APK and install it.', grow: 60, field: 'forest' },
  { time: 'Seconds', clause: 'Then paste one key, or pick a model on the phone.', grow: 14, field: 'ocean' },
  { time: 'Seconds', clause: 'Now ask, talk or attach a file.', grow: 14, field: 'rose' },
  { time: 'A few minutes', clause: 'Deep Research keeps going with the screen off.', grow: 180, field: 'mono' },
];
---
<section class="chapter timing" id="how" aria-labelledby="how-title">
  <h2 id="how-title" class="head" data-reveal>How long it takes</h2>

  <ol class="bar" data-ui data-bar>
    {stages.map((s, i) => (
      <li class={`seg f-${s.field}`} style={`--grow:${s.grow}; --i:${i}`}>
        <span class="seg-time">{s.time}</span>
        <span class="seg-clause">{s.clause}</span>
      </li>
    ))}
  </ol>
</section>

<style>
  .timing { display: grid; align-content: center; gap: 64px; }
  .bar { display: flex; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .seg { flex: var(--grow) 1 0; min-width: 12%; position: relative; height: 22vh; min-height: 160px; padding: 20px; margin-bottom: 7rem; }
  .seg-time { display: block; font-size: clamp(20px, 2vw, 30px); font-weight: 700; letter-spacing: -0.01em; line-height: 1.1; }
  .seg-clause { position: absolute; top: calc(100% + 16px); left: 0; width: 22ch; max-width: 100%; color: var(--ink); font-size: var(--step-body); }

  @media (max-width: 48em) {
    .timing { gap: 2.5rem; }
    .timing h2 { font-size: 11vw; }
    .bar { flex-direction: column; height: 70svh; }
    .seg { flex: var(--grow) 1 0; min-width: 0; min-height: 96px; height: auto; margin-bottom: 0; display: grid; align-content: start; gap: 6px; }
    .seg-time { font-size: 22px; }
    .seg-clause { position: static; color: inherit; width: auto; font-size: 16px; }
  }
</style>

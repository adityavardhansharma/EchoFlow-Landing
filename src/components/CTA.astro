---
import PhoneFrame from './PhoneFrame.astro';
import Seal from './Seal.astro';
import { flower } from '../lib/shapes';
import { RELEASES_URL } from '../lib/releases';
const ring = flower(12, 50, 43);
const REPO = 'https://github.com/adityavardhansharma/EchoFlow';
---
<section id="get" class="dark cta">
  <div class="wrap-wide">
    <div class="cta-card reveal">
      <svg class="ring r1" viewBox="0 0 100 100" aria-hidden="true"><path d={ring} /></svg>
      <svg class="ring r2" viewBox="0 0 100 100" aria-hidden="true"><path d={ring} /></svg>
      <span class="cta-glow" aria-hidden="true"></span>

      <div class="cta-copy">
        <Seal size={66} logo fill="#fff" class="cta-seal" />
        <h2 class="display">Start<br />the flow.</h2>
        <p class="lead">Bring your OpenRouter key, pick your models, choose your color —
        and start talking to an AI that finally feels like yours.</p>
        <div class="cta-actions">
          <a class="btn btn-light" href={RELEASES_URL} data-apk rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.6 9.5 16 6.8a.4.4 0 0 0-.7.5L17 9.9A9.6 9.6 0 0 0 12 8.6a9.6 9.6 0 0 0-5 1.3l1.6-2.6a.4.4 0 0 0-.7-.5L6.4 9.5A8 8 0 0 0 3 15.6h18a8 8 0 0 0-3.4-6.1ZM8 13.4a.8.8 0 1 1 .8-.8.8.8 0 0 1-.8.8Zm8 0a.8.8 0 1 1 .8-.8.8.8 0 0 1-.8.8Z"/></svg>
            Download for Android
          </a>
          <a class="btn btn-ghost-cta" href={REPO} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
            Star on GitHub
          </a>
        </div>
        <p class="fine">Free · OpenRouter · No account required</p>
      </div>

      <div class="cta-visual" aria-hidden="true">
        <PhoneFrame tone="dark"><img src="/brand/shot-home-ocean.jpg" alt="" loading="lazy" width="260" height="563" /></PhoneFrame>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .cta-card {
    position: relative; overflow: hidden; border-radius: var(--r-xl);
    background: linear-gradient(135deg, #1746a0 0%, #103173 55%, #0c1f48 100%);
    border: 1px solid rgba(140,180,255,.22);
    box-shadow: 0 50px 100px -40px rgba(12,40,90,.8), inset 0 1px 0 rgba(255,255,255,.12);
    display: grid; grid-template-columns: 1.15fr .85fr; align-items: center; gap: 2rem;
    padding: clamp(2.4rem, 5vw, 4rem);
  }
  .ring { position: absolute; opacity: .08; pointer-events: none; }
  .ring path { fill: #cfe2ff; }
  .r1 { width: 360px; top: -120px; right: -80px; animation: spin 50s linear infinite; transform-origin: center; }
  .r2 { width: 220px; bottom: -90px; left: -60px; animation: spin 40s linear infinite reverse; transform-origin: center; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .cta-glow { position: absolute; width: 480px; height: 480px; left: 30%; top: -40%;
    background: radial-gradient(circle, rgba(120,170,255,.5), transparent 65%); filter: blur(70px); }

  .cta-copy { position: relative; z-index: 1; color: #fff; }
  .cta-copy > * + * { margin-top: 1.2rem; }
  .cta-seal { filter: drop-shadow(0 14px 28px rgba(0,0,0,.4)); animation: bob 5s var(--ease) infinite alternate; }
  @keyframes bob { to { transform: translateY(-10px) rotate(6deg); } }
  .cta .display { font-size: clamp(2.8rem, 6vw, 4.6rem); }
  .cta-copy .lead { color: rgba(233,241,251,.85); max-width: 42ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.6rem; }
  .btn-ghost-cta { color: #fff; border: 1.5px solid rgba(207,226,255,.4); background: rgba(255,255,255,.06); }
  .btn-ghost-cta:hover { background: rgba(255,255,255,.14); transform: translateY(-2px); }
  .fine { font-family: var(--mono); font-size: .78rem; color: rgba(207,226,255,.7); letter-spacing: .05em; }

  .cta-visual { position: relative; z-index: 1; display: grid; place-items: center; }
  .cta-visual :global(.phone) { width: min(250px, 64vw);
    transform: rotate(4deg) translateY(8px); filter: drop-shadow(0 40px 60px rgba(0,0,0,.5)); }

  @media (max-width: 820px) {
    .cta-card { grid-template-columns: 1fr; text-align: center; }
    .cta-copy { display: flex; flex-direction: column; align-items: center; }
    .cta-actions { justify-content: center; }
    .cta-visual { order: -1; margin-bottom: .5rem; }
    .cta-visual :global(.phone) { transform: none; width: min(230px, 62vw); }
  }
</style>

---
import PhoneFrame from './PhoneFrame.astro';
/* Full-bleed stop for the on-device document engine. The visual is the story:
   file-format badges drift into the phone and disappear — read on the device,
   never uploaded. Badges are pure CSS; motion is disabled for reduced-motion. */
const badges = [
  // resting position (% of stage), fill color, label — spread around the phone
  { l: 12, t: 14, c: '#185abd', txt: 'W',    name: 'Word' },
  { l: 5,  t: 44, c: '#107c41', txt: 'X',    name: 'Excel' },
  { l: 14, t: 76, c: '#c43e1c', txt: 'P',    name: 'PowerPoint' },
  { l: 84, t: 12, c: '#d93025', txt: 'PDF',  name: 'PDF' },
  { l: 92, t: 42, c: '#6750a4', txt: 'EPUB', name: 'EPUB' },
  { l: 85, t: 74, c: '#0e7569', txt: 'CSV',  name: 'CSV' },
  { l: 30, t: 2,  c: '#8a8a2c', txt: 'RTF',  name: 'RTF' },
  { l: 68, t: 94, c: '#b4540b', txt: 'SCAN', name: 'Scanned page' },
];
---
<section class="reader" id="reader">
  <div class="wrap" data-reveal>
    <p class="r-kicker">03 — The reader</p>
    <h2 class="r-title">Feed it anything.</h2>
    <p class="r-body">
      A document engine ships inside the APK: Word, Excel, PowerPoint, PDF, EPUB
      become clean Markdown <em>on the phone</em>, scans go through on-device OCR —
      so even a local model with no internet can read your files.
      Nothing is uploaded just to open a document.
    </p>
  </div>

  <div class="stage" data-reveal>
    {badges.map((b, i) => (
      <span
        class="fbadge"
        style={`--c:${b.c}; left:${b.l}%; top:${b.t}%; --dx:${(50 - b.l) * 4.4}px; --dy:${(46 - b.t) * 3.6}px; animation-delay:${i * 1.1}s`}
        title={b.name}
      >{b.txt}</span>
    ))}
    <PhoneFrame tone="light" class="r-phone">
      <img src="/brand/v3/02-chat-home-light-theme.jpg" alt="EchoFlow ready for any attachment" width="724" height="1568" loading="lazy" decoding="async" />
    </PhoneFrame>
  </div>
</section>

<style>
  .reader { text-align: center;
    /* Full-bleed escape from the .tour column — the one stop that isn't a box. */
    width: 100vw; margin-inline: calc(50% - 50vw);
    padding-block: clamp(3.5rem, 7vw, 6rem);
    margin-block: clamp(1.2rem, 2.5vw, 2rem);
    border-block: 1px solid color-mix(in oklab, var(--olive) 22%, transparent);
    background:
      radial-gradient(120% 90% at 50% 0%, color-mix(in oklab, var(--butter) 34%, transparent), transparent 70%),
      color-mix(in oklab, var(--butter) 14%, var(--paper));
  }
  .reader .wrap > * + * { margin-top: 1.2rem; }
  .r-kicker { font-family: var(--mono); font-size: .78rem; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase; color: var(--olive); }
  .r-title { font-family: var(--display); font-weight: 800; line-height: 1.02;
    letter-spacing: -.025em; font-size: clamp(2.1rem, 5vw, 3.9rem); }
  .r-body { max-width: 56ch; margin-inline: auto; color: var(--on-paper-soft);
    font-size: clamp(1rem, 1.4vw, 1.16rem); line-height: 1.65; }
  .r-body em { font-style: normal; font-weight: 700; color: var(--olive); }

  .stage { position: relative; margin: clamp(2.2rem, 4vw, 3.4rem) auto 0;
    width: min(640px, 92vw); display: grid; place-items: center; }
  .stage :global(.r-phone) { width: min(238px, 58vw); position: relative; z-index: 1;
    filter: drop-shadow(0 30px 54px rgba(46,42,24,.32)); }

  .fbadge { position: absolute; z-index: 2; display: grid; place-items: center;
    min-width: 46px; height: 46px; padding-inline: .55rem;
    /* file-icon silhouette: one clipped corner */
    border-radius: 12px 55% 12px 12px; background: var(--c); color: #fff;
    font-family: var(--mono); font-weight: 700; font-size: .8rem; letter-spacing: .02em;
    box-shadow: 0 12px 24px -12px color-mix(in oklab, var(--c) 70%, #000);
    animation: feed 9s var(--ease) infinite both; will-change: transform, opacity; }
  .fbadge::after { content: ''; position: absolute; top: 3px; right: 3px;
    width: 9px; height: 9px; border-radius: 2px 55% 2px 55%;
    background: color-mix(in oklab, var(--c) 45%, #fff); }

  @keyframes feed {
    0%   { transform: translate(0, 0) scale(1); opacity: 0; }
    6%   { opacity: 1; }
    55%  { transform: translate(0, 0) scale(1); opacity: 1; }
    92%  { transform: translate(var(--dx), var(--dy)) scale(.3); opacity: 0; }
    100% { transform: translate(var(--dx), var(--dy)) scale(.3); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fbadge { animation: none; opacity: 1; }
  }
</style>

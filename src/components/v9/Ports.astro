---
/* Every port — cards crossing a held photograph. Aivazovsky's "The Ninth
   Wave" holds still behind the stage while the ports of call travel across
   it: every place a message from EchoFlow can sail to. */
const ports = [
  { name: 'OpenRouter', text: 'Every cloud model on one key, from one catalogue.', img: '/brand/v9/chart-1320.jpg', w: 1800, h: 1316, pos: '40% 45%', alt: 'A Mediterranean portolan chart from about 1320, its rhumb lines crossing the sea between ports', tone: '#5f6b78' },
  { name: 'The big providers', text: 'OpenAI, Anthropic and Gemini, each on a key you own.', img: '/brand/shot-cloud-models.jpg', w: 720, h: 1560, pos: '50% 12%', alt: 'EchoFlow cloud models list with keys saved on the device', tone: '#6b5d4f' },
  { name: 'And further out', text: 'Cerebras, xAI and Sarvam, in the same chat.', img: '/brand/v9/wave-hokusai.jpg', w: 1800, h: 1232, pos: '30% 40%', alt: 'The Great Wave off Kanagawa by Katsushika Hokusai: a great wave curling over boats, Mount Fuji small beyond', tone: '#4f5e56' },
  { name: 'Your own PC', text: 'Ollama, LM Studio or any OpenAI-compatible server, over Wi-Fi.', img: '/brand/v3/09-custom-api-endpoints.jpg', w: 945, h: 2048, pos: '50% 34%', alt: 'Custom API endpoint settings with Ollama switched on', tone: '#66525a' },
  { name: 'The phone', text: 'Gemma, Qwen or your own model file. No signal needed.', img: '/brand/v3/10-chat-on-device-model.jpg', w: 945, h: 2048, pos: '50% 96%', alt: 'A chat answered by a model running on the phone', tone: '#5d5f4c' },
];
---
<section class="ports c-sky" id="ports" aria-labelledby="ports-title" data-ports>
  <div class="p-head grid">
    <h2 id="ports-title" class="head" data-reveal>Every port is open</h2>
    <div class="p-side" data-reveal style="--i:1">
      <p class="p-lede">A message from EchoFlow sails straight to the port you choose. Nothing in between, and nobody takes a cut.</p>
      <p class="p-cap">Behind the cards: The Ninth Wave, Ivan Aivazovsky, 1850</p>
    </div>
  </div>
  <div class="stage-wrap" data-wrap>
  <div class="stage">
    <img class="held" src="/brand/v9/sea-aivazovsky.jpg" width="2400" height="1586" loading="lazy" decoding="async"
      alt="The Ninth Wave by Ivan Aivazovsky: survivors cling to a mast in a vast sea under a burning sky" />
    <ol class="track" data-track>
      {ports.map((p) => (
        <li class="card">
          <img src={p.img} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" style={`object-position:${p.pos}`} />
          <div class="panel" style={`background:${p.tone}`}>
            <h3>{p.name}</h3>
            <p>{p.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  </div>
</section>

<script>
  // On a wide screen, with motion allowed, the stage holds still and the
  // cards travel across the held sea as the page scrolls (two screens).
  const sec = document.querySelector<HTMLElement>('[data-ports]');
  const wide = matchMedia('(min-width: 60em) and (prefers-reduced-motion: no-preference)');
  if (sec) {
    const track = sec.querySelector<HTMLElement>('[data-track]')!;
    const wrap = sec.querySelector<HTMLElement>('[data-wrap]')!;
    let raf = 0;
    const place = () => {
      if (!sec.classList.contains('is-live')) return;
      const cards = track.children;
      const cw = (cards[0] as HTMLElement).offsetWidth + 40;
      const start = innerWidth / 2 - (cards[0] as HTMLElement).offsetWidth / 2;
      const r = wrap.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / (wrap.offsetHeight - innerHeight)));
      track.style.transform = `translate3d(${start - p * (cards.length - 1) * cw}px, 0, 0)`;
    };
    const setup = () => {
      sec.classList.toggle('is-live', wide.matches);
      if (!wide.matches) track.style.transform = '';
      place();
    };
    addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(place); }, { passive: true });
    addEventListener('resize', place);
    wide.addEventListener('change', setup);
    setup();
  }
</script>

<style>
  /* the finished composition: also what reduced motion and phones see */
  .ports { position: relative; }
  .stage { position: relative; overflow: hidden; padding: clamp(4rem, 7vw, 6rem) var(--margin); }
  .held { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.6); }
  .p-head { padding: clamp(4rem, 7vw, 6rem) var(--margin) 3rem; align-items: end; row-gap: 1.5rem; }
  .p-head h2 { grid-column: 1 / 7; }
  .p-side { grid-column: 8 / 13; display: grid; gap: 0.75rem; }
  .p-lede { font-size: var(--step-lead); line-height: 1.35; }
  .p-cap { font-size: var(--step-small); }
  .track { position: relative; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }
  .card { display: grid; grid-template-rows: 68% 32%; aspect-ratio: 4 / 3.2; overflow: hidden; color: #ffffff; }
  .card img { width: 100%; height: 100%; object-fit: cover; }
  .panel { padding: 20px 24px; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
  .panel h3 { font-size: var(--step-sub); font-weight: 300; }
  .panel p { font-size: 1rem; max-width: 26ch; text-align: right; line-height: 1.4; }

  /* live: the stage is held for two screens while the cards cross it */
  .ports.is-live .stage-wrap { height: 220svh; }
  .ports.is-live .stage { position: sticky; top: 0; height: 100svh; padding: 0; }
  .ports.is-live .track { position: absolute; top: 50%; left: 0; display: flex; gap: 40px; margin-top: -280px; will-change: transform; }
  .ports.is-live .card { flex: none; width: 720px; height: 560px; aspect-ratio: auto; }

  @media (max-width: 48em) {
    .p-head h2, .p-side { grid-column: 1 / -1; }
    .track { grid-template-columns: 1fr; }
    .card { aspect-ratio: auto; grid-template-rows: auto auto; }
    .card img { aspect-ratio: 4 / 3; }
    .panel { min-height: 140px; flex-direction: column; align-items: flex-start; justify-content: flex-end; }
    .panel p { text-align: left; }
  }
</style>

---
import PhoneFrame from './PhoneFrame.astro';
import Seal from './Seal.astro';
---
<section id="models" class="dark models">
  <div class="atmos" aria-hidden="true"><span class="glow"></span></div>

  <div class="wrap-wide models-grid">
    <div class="models-copy reveal">
      <span class="kicker" style="color:var(--blue-bright)">Powered by OpenRouter</span>
      <h2 class="h2">One key.<br />Every model<br />worth using.</h2>
      <p class="lead muted">
        EchoFlow doesn't lock you to one provider. Paste your OpenRouter key once, then
        add any model by its ID — frontier or free, reasoning or fast. Switch between
        them mid-conversation from a single tap.
      </p>
      <div class="key-demo">
        <span class="kd-label">Your key, stored on-device</span>
        <code class="kd-field">sk-or-v1-•••••••••••••••••••••••••••••</code>
      </div>
      <ul class="checks">
        <li><Seal size={22} fill="var(--blue-600)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg></Seal> Add custom models by ID + display name</li>
        <li><Seal size={22} fill="var(--blue-600)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg></Seal> Search &amp; swap models from a bottom sheet</li>
        <li><Seal size={22} fill="var(--blue-600)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg></Seal> Free models work out of the box</li>
      </ul>
    </div>

    <div class="models-visual reveal" data-d="1">
      <PhoneFrame tone="light" class="mv-back"><img src="/brand/shot-cloud-models.jpg" alt="Your OpenRouter models and the model directory" loading="lazy" width="240" height="520" /></PhoneFrame>
      <PhoneFrame tone="dark" class="mv-front"><img src="/brand/shot-home.jpg" alt="Switch models from the chat header" loading="lazy" width="240" height="520" /></PhoneFrame>
    </div>
  </div>
</section>

<style>
  .models { overflow: hidden; }
  .atmos { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .glow { position: absolute; width: 700px; height: 500px; left: 50%; top: -120px; transform: translateX(-50%);
    background: radial-gradient(ellipse, #1746a0, transparent 70%); filter: blur(80px); opacity: .5; }

  .models-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .models-copy > * + * { margin-top: 1.4rem; }
  .key-demo { display: flex; flex-direction: column; gap: .5rem; }
  .kd-label { font-family: var(--mono); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--on-ink-soft); }
  .kd-field { display: block; font-family: var(--mono); font-size: .92rem; color: var(--blue-bright);
    background: rgba(8,17,31,.6); border: 1px solid var(--line-dark); border-radius: var(--r-s);
    padding: .85rem 1rem; overflow: hidden; }
  .checks { list-style: none; padding: 0; display: grid; gap: .8rem; margin-top: 1.6rem; }
  .checks li { display: flex; align-items: center; gap: .75rem; font-weight: 500; }

  .models-visual { position: relative; display: grid; place-items: center; min-height: 480px; }
  .models-visual :global(.phone) { position: absolute; }
  .mv-back { width: 210px; transform: translate(28%, -8%) rotate(6deg); opacity: .92; z-index: 1; }
  .mv-front { width: 232px; transform: translate(-22%, 10%) rotate(-5deg); z-index: 2; }

  @media (max-width: 860px) {
    .models-grid { grid-template-columns: 1fr; text-align: center; }
    .models-copy { display: flex; flex-direction: column; align-items: center; }
    .checks li { justify-content: center; text-align: left; }
    .models-visual { min-height: 540px; margin-top: 1.5rem; }
  }
  @media (max-width: 480px) {
    .mv-back { width: 165px; } .mv-front { width: 185px; }
  }
</style>

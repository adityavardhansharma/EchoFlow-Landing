---
import { flower } from '../lib/shapes';
/* The Artifact Gallery gets its own stop. Until the real screenshot lands, the
   visual is a stylized shelf of artifact cards — swap `.shelf` for a PhoneFrame
   with the gallery shot when it's available. */
const mark = flower(8, 50, 42);
const cards = [
  { type: 'Page', title: 'Industrial Brutalist Calculator', meta: 'v3 · 4,512 chars' },
  { type: 'Report', title: 'Warranty claim — evidence & timeline', meta: 'v2 · Deep Research' },
  { type: 'Document', title: 'October trip — shared budget', meta: 'v5 · edited today' },
];
---
<section class="panel-slot" id="artifact-gallery">
  <article class="apanel" style="--tint:var(--c-sunset)">
    <div class="a-copy" data-reveal>
      <span class="chip a-chip"><b><span>09</span></b>Artifacts</span>
      <h2 class="h2">Ask for a thing.<br />Keep the thing.</h2>
      <p class="a-body">
        When a model builds you something — a working web page, a cited report, a
        document — it doesn't scroll away into chat history. It lands in the
        Artifact Gallery: previewable, versioned, and there next week when you
        want it changed.
      </p>
      <ul class="a-facts">
        <li>Every version kept — roll back anytime</li>
        <li>Preview, share, or reopen to keep editing</li>
        <li>Pages, reports, documents, code</li>
      </ul>
    </div>
    <div class="a-visual" data-reveal aria-hidden="true">
      <div class="shelf">
        {cards.map((c) => (
          <div class="acard">
            <svg viewBox="0 0 100 100"><path d={mark} /></svg>
            <span class="a-type">{c.type}</span>
            <strong>{c.title}</strong>
            <span class="a-meta">{c.meta}</span>
          </div>
        ))}
      </div>
    </div>
  </article>
</section>

<style>
  .panel-slot { height: 100%; }
  .apanel {
    display: grid; grid-template-columns: .95fr 1.05fr; align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-radius: var(--r-xl);
    padding: clamp(1.8rem, 4.5vw, 4.2rem);
    background: color-mix(in oklab, var(--tint) 13%, var(--card));
    border: 1px solid color-mix(in oklab, var(--tint) 24%, transparent);
    overflow: hidden; position: relative;
  }
  .a-copy > * + * { margin-top: 1.25rem; }
  .a-chip { color: color-mix(in oklab, var(--tint) 80%, var(--on-paper)); }
  .a-chip b span { color: var(--card); }
  .a-body { font-size: clamp(1.02rem, 1.4vw, 1.18rem); line-height: 1.6;
    max-width: 46ch; color: var(--on-paper-soft); }
  .a-facts { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .a-facts li { padding: .5rem .95rem; border-radius: var(--r-full);
    background: color-mix(in oklab, var(--tint) 16%, transparent);
    border: 1px solid color-mix(in oklab, var(--tint) 26%, transparent);
    font-size: .86rem; font-weight: 600;
    color: color-mix(in oklab, var(--tint) 62%, var(--on-paper)); }

  .a-visual { display: grid; place-items: center; }
  .shelf { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(.6rem, 1.5vw, 1rem); width: 100%; max-width: 560px; align-items: start; }
  .acard { display: grid; gap: .5rem; align-content: start;
    background: var(--card); border: 1px solid var(--line);
    border-radius: var(--r-m); padding: 1.1rem 1rem 1rem; min-height: 172px;
    box-shadow: 0 22px 40px -26px rgba(46,42,24,.5);
    transition: transform .5s var(--spring), box-shadow .5s; }
  .acard:nth-child(1) { transform: rotate(-3.5deg) translateY(10px); }
  .acard:nth-child(2) { transform: rotate(1.5deg) translateY(-8px); }
  .acard:nth-child(3) { transform: rotate(4deg) translateY(14px); }
  .acard:hover { transform: rotate(0) translateY(-4px);
    box-shadow: 0 30px 48px -24px rgba(46,42,24,.55); }
  .acard svg { width: 26px; height: 26px; fill: var(--tint); opacity: .9; }
  .a-type { font-family: var(--mono); font-size: .68rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .08em;
    color: color-mix(in oklab, var(--tint) 75%, var(--on-paper)); }
  .acard strong { font-family: var(--display); font-weight: 700; line-height: 1.2;
    font-size: .95rem; letter-spacing: -.01em; }
  .a-meta { font-size: .76rem; color: var(--on-paper-soft); }

  @media (max-width: 880px) {
    .apanel { grid-template-columns: 1fr; }
    .a-visual { margin-top: 1.5rem; }
    .acard { min-height: 0; }
  }
</style>

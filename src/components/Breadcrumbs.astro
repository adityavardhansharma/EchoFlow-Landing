---
interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={item.path}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs { margin-bottom: 1rem; }
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem;
    font-family: var(--mono); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase;
    color: var(--on-ink-soft); }
  .crumbs li:not(:last-child)::after { content: '/'; margin-left: .35rem; opacity: .5; }
  .crumbs a:hover { color: var(--on-ink); }
  .crumbs [aria-current] { color: var(--blue-bright); }
</style>

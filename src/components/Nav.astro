---
import Seal from './Seal.astro';
import { RELEASES_URL } from '../lib/releases';
import { featureLinks } from '../lib/navigation';
const REPO = 'https://github.com/adityavardhansharma/EchoFlow';
const isHome = Astro.url.pathname === '/';
---
<header class="nav">
  <div class="wrap-wide nav-in">
    <a class="brand" href="/" aria-label="EchoFlow home">
      <Seal size={34} logo fill="var(--blue-600)" />
      <span>EchoFlow</span>
    </a>
    <nav class="links" aria-label="Primary">
      <div class="dropdown">
        <button type="button" class="drop-trigger" aria-haspopup="true" aria-expanded="false">Features</button>
        <div class="drop-menu" role="menu">
          {featureLinks.map((link) => (
            <a href={link.href} role="menuitem">{link.label}</a>
          ))}
        </div>
      </div>
      <a href="/alternatives">Alternatives</a>
      <a href="/guides">Guides</a>
      <a href="/open-source">Open Source</a>
      {isHome && <a href="#features">All features</a>}
    </nav>
    <a class="btn btn-light dl" href={RELEASES_URL} data-apk rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 3v10.6l3.3-3.3 1.4 1.4L12 17.4 6.3 11.7l1.4-1.4L11 13.6V3zM5 19h14v2H5z"/></svg>
      Download
    </a>
  </div>
</header>

<style>
  .nav { position: sticky; top: 0; z-index: 80;
    background: color-mix(in oklab, var(--ink) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.3);
    border-bottom: 1px solid var(--line-dark); }
  .nav-in { display: flex; align-items: center; gap: 1.4rem; height: 66px; color: var(--on-ink); }
  .brand { display: inline-flex; align-items: center; gap: .6rem; font-family: var(--display);
    font-weight: 800; font-size: 1.22rem; letter-spacing: -.03em; }
  .links { display: flex; align-items: center; gap: 1.4rem; margin-left: auto;
    font-weight: 500; font-size: .95rem; color: var(--on-ink-soft); }
  .links > a, .drop-trigger { position: relative; transition: color .2s; color: inherit;
    background: none; border: 0; font: inherit; cursor: pointer; padding: 0; }
  .links a:hover, .drop-trigger:hover { color: var(--on-ink); }
  .dropdown { position: relative; }
  .drop-menu { display: none; position: absolute; top: calc(100% + .6rem); left: -1rem;
    min-width: 220px; background: var(--ink-2); border: 1px solid var(--line-dark);
    border-radius: var(--r-m); padding: .5rem; box-shadow: 0 20px 40px rgba(0,0,0,.4); }
  .dropdown:hover .drop-menu, .dropdown:focus-within .drop-menu { display: grid; }
  .drop-menu a { display: block; padding: .55rem .75rem; border-radius: var(--r-s);
    font-size: .9rem; white-space: nowrap; }
  .drop-menu a:hover { background: rgba(255,255,255,.06); color: var(--on-ink); }
  .dl { padding: .55rem 1.15rem; font-size: .95rem; }
  @media (max-width: 900px) { .links { display: none; } }
</style>

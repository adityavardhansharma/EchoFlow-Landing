---
import PhoneFrame from './PhoneFrame.astro';
import Seal from './Seal.astro';
const swatches = [
  { n: 'Wallpaper', c: 'var(--c-wall)' },
  { n: 'Mono', c: 'var(--c-mono)' },
  { n: 'Ocean', c: 'var(--c-ocean)' },
  { n: 'Forest', c: 'var(--c-forest)' },
  { n: 'Sunset', c: 'var(--c-sunset)' },
  { n: 'Lavender', c: 'var(--c-lavender)' },
  { n: 'Rose', c: 'var(--c-rose)' },
];
const shots = [
  { src: '/brand/shot-appearance.jpg', tone: 'light', cap: 'Appearance', sub: 'pick theme + accent', dot: 'var(--c-ocean)' },
  { src: '/brand/v2/chat-green.jpg', tone: 'light', cap: 'Forest', sub: 'light', dot: 'var(--c-forest)' },
  { src: '/brand/shot-home-lavender.jpg', tone: 'light', cap: 'Lavender', sub: 'light', dot: 'var(--c-lavender)' },
];
---
<section id="themes" class="paper themes">
  <div class="wrap themes-head reveal">
    <span class="kicker" style="color:var(--c-lavender)">Make it yours</span>
    <h2 class="h2">Seven palettes. Light &amp; dark.<br /><span style="color:var(--c-lavender)">Material&nbsp;You.</span></h2>
    <p class="lead muted">Each theme recolors the entire app, in light and dark. On Android&nbsp;12+,
    <b>Wallpaper</b> pulls your palette straight from your home screen.</p>
  </div>

  <div class="wrap-wide stage reveal" data-d="1">
    <div class="swatch-strip">
      {swatches.map((s) => (
        <span class="sw">
          <Seal size={44} fill={s.c}>
            {s.n === 'Wallpaper' && <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 4a8 8 0 1 0 0 16 2 2 0 0 0 0-4 2 2 0 0 1 0-4 2 2 0 0 0 0-4 2 2 0 0 1 0-4Z"/></svg>}
          </Seal>
          <span>{s.n}</span>
        </span>
      ))}
    </div>

    <div class="gallery">
      {shots.map((s, i) => (
        <figure class="shot reveal" data-d={String(i + 1)}>
          <PhoneFrame tone={s.tone as 'dark' | 'light'}>
            <img src={s.src} alt={`${s.cap} ${s.sub}`} loading="lazy" width="240" height="520" />
          </PhoneFrame>
          <figcaption><i style={`background:${s.dot}`}></i> {s.cap} <span>· {s.sub}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .themes { background: linear-gradient(var(--paper), var(--paper-2)); }
  .themes-head { max-width: 62ch; }
  .themes-head > * + * { margin-top: 1.1rem; }

  .stage { margin-top: clamp(2.5rem, 5vw, 3.5rem);
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r-xl);
    padding: clamp(1.6rem, 4vw, 3rem); box-shadow: 0 40px 80px -50px rgba(20,30,50,.45); }

  .swatch-strip { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.1rem 1.6rem;
    padding-bottom: clamp(2rem, 4vw, 3rem); margin-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line); }
  .sw { display: inline-flex; flex-direction: column; align-items: center; gap: .45rem;
    font-weight: 600; font-size: .88rem; color: var(--on-paper-soft); transition: transform .5s var(--spring); }
  .sw:hover { transform: translateY(-5px); }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.2rem, 3vw, 2.4rem);
    justify-items: center; align-items: start; }
  .shot { display: grid; justify-items: center; gap: .9rem; margin: 0; }
  .shot :global(.phone) { width: min(230px, 60vw); }
  figcaption { font-family: var(--mono); font-size: .76rem; color: var(--on-paper);
    display: inline-flex; align-items: center; gap: .5rem; }
  figcaption span { color: var(--on-paper-soft); }
  figcaption i { width: 11px; height: 11px; border-radius: 50%; display: inline-block; }

  @media (max-width: 760px) {
    .gallery { grid-template-columns: 1fr; }
    .shot :global(.phone) { width: min(260px, 72vw); }
  }
</style>

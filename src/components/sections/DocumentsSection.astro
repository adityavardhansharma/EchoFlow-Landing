---
import Seal from '../Seal.astro';

/* Supported formats, drawn as real folded-corner file icons that morph into one
   another inside the main card. Order controls the morph cycle. */
const formats = [
  { ext: 'PDF',  color: '#e5342a' },
  { ext: 'XLSX', color: '#217346' },
  { ext: 'DOCX', color: '#2b579a' },
  { ext: 'CSV',  color: '#0f766e' },
];
/* Satellite mini-icons that float around the card. */
const satellites = [
  { ext: 'PPT', color: '#d24726', x: 12,  y: 40,  d: '0s'   },
  { ext: 'MD',  color: '#5a6473', x: 348, y: 88,  d: '.9s'  },
  { ext: 'TXT', color: '#3b82f6', x: 30,  y: 356, d: '1.6s' },
  { ext: 'RTF', color: '#8b5cf6', x: 352, y: 322, d: '2.3s' },
];
---
<section id="documents" class="dark documents">
  <div class="atmos" aria-hidden="true"><span class="glow"></span></div>
  <div class="wrap-wide grid">
    <div class="copy">
      <span class="kicker" style="color:var(--blue-bright)">Documents</span>
      <h2 class="h2">Drop a file.<br />Ask anything.</h2>
      <p class="lead muted">
        PDFs, spreadsheets, slide decks, CSVs — attach them and chat. Summarise a report,
        extract every table, compare two versions, or study for an exam, with cloud models
        or fully offline on-device.
      </p>
      <ul class="checks">
        <li><Seal size={22} fill="var(--blue-600)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg></Seal> PDF, Word, Excel, PowerPoint, CSV &amp; more</li>
        <li><Seal size={22} fill="var(--blue-600)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg></Seal> Extract tables &amp; data into clean answers</li>
        <li><Seal size={22} fill="var(--blue-600)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg></Seal> Works with <b>local on-device</b> models, offline</li>
      </ul>
      <a class="section-link" href="/documents">Document workflows →</a>
    </div>

    <div class="visual">
      <svg class="doc-scene" viewBox="0 0 420 470" role="img"
           aria-label="A document morphing between PDF, Excel, Word and CSV as EchoFlow reads it">
        <defs>
          <linearGradient id="doc-paper" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffffff"/>
            <stop offset="1" stop-color="#eef2f8"/>
          </linearGradient>
          <linearGradient id="doc-scan" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#88b9ff" stop-opacity="0"/>
            <stop offset="0.5" stop-color="#88b9ff" stop-opacity="0.55"/>
            <stop offset="1" stop-color="#88b9ff" stop-opacity="0"/>
          </linearGradient>
          <clipPath id="doc-clip">
            <path d="M130 66 H284 L330 112 V364 a18 18 0 0 1 -18 18 H128 a18 18 0 0 1 -18 -18 V84 a18 18 0 0 1 18 -18 Z"/>
          </clipPath>
          <filter id="doc-shadow" x="-40%" y="-30%" width="180%" height="180%">
            <feDropShadow dx="0" dy="26" stdDeviation="26" flood-color="#040a16" flood-opacity="0.55"/>
          </filter>
        </defs>

        <!-- depth: ghost cards behind -->
        <g class="ghosts" aria-hidden="true">
          <rect x="150" y="80" width="200" height="300" rx="18" transform="rotate(7 250 230)"/>
          <rect x="96"  y="74" width="200" height="300" rx="18" transform="rotate(-5 196 224)"/>
        </g>

        <!-- main morphing document -->
        <g class="doc-card" filter="url(#doc-shadow)">
          <path class="paper" d="M130 66 H284 L330 112 V364 a18 18 0 0 1 -18 18 H128 a18 18 0 0 1 -18 -18 V84 a18 18 0 0 1 18 -18 Z"/>
          <path class="fold" d="M284 66 V112 H330 Z"/>

          <g clip-path="url(#doc-clip)">
            <!-- PDF -->
            <g class="fmt f0" style="--d:0s">
              <rect class="ln" x="150" y="152" width="120" height="12" rx="6"/>
              <rect class="ln lite" x="150" y="176" width="150" height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="194" width="140" height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="212" width="150" height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="230" width="96"  height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="262" width="150" height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="280" width="132" height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="298" width="150" height="9" rx="4.5"/>
              <rect class="chip" x="150" y="322" width="150" height="34" rx="8" fill="#fbe3e1"/>
            </g>
            <!-- Excel -->
            <g class="fmt f1" style="--d:4s">
              <g class="xls-grid">
                <rect x="150" y="152" width="152" height="26" rx="3" fill="#217346"/>
                <rect x="150" y="182" width="48" height="22" rx="2"/>
                <rect x="202" y="182" width="48" height="22" rx="2"/>
                <rect x="254" y="182" width="48" height="22" rx="2" fill="#c9ead6"/>
                <rect x="150" y="208" width="48" height="22" rx="2"/>
                <rect x="202" y="208" width="48" height="22" rx="2" fill="#c9ead6"/>
                <rect x="254" y="208" width="48" height="22" rx="2"/>
                <rect x="150" y="234" width="48" height="22" rx="2" fill="#c9ead6"/>
                <rect x="202" y="234" width="48" height="22" rx="2"/>
                <rect x="254" y="234" width="48" height="22" rx="2"/>
                <rect x="150" y="260" width="48" height="22" rx="2"/>
                <rect x="202" y="260" width="48" height="22" rx="2" fill="#c9ead6"/>
                <rect x="254" y="260" width="48" height="22" rx="2"/>
                <rect x="150" y="286" width="48" height="22" rx="2"/>
                <rect x="202" y="286" width="48" height="22" rx="2"/>
                <rect x="254" y="286" width="48" height="22" rx="2" fill="#c9ead6"/>
              </g>
            </g>
            <!-- Word -->
            <g class="fmt f2" style="--d:8s">
              <rect class="ln" x="150" y="152" width="92"  height="16" rx="8" fill="#2b579a"/>
              <rect class="ln lite" x="150" y="182" width="150" height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="200" width="150" height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="218" width="120" height="9" rx="4.5"/>
              <rect class="ln" x="150" y="248" width="70"  height="12" rx="6" fill="#89a7d6"/>
              <rect class="ln lite" x="150" y="270" width="150" height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="288" width="150" height="9" rx="4.5"/>
              <rect class="ln lite" x="150" y="306" width="108" height="9" rx="4.5"/>
            </g>
            <!-- CSV -->
            <g class="fmt f3" style="--d:12s">
              <g class="csv-rows">
                <rect x="150" y="156" width="34" height="12" rx="3" fill="#0f766e"/>
                <rect x="196" y="156" width="46" height="12" rx="3" fill="#0f766e"/>
                <rect x="254" y="156" width="40" height="12" rx="3" fill="#0f766e"/>
                <rect x="150" y="188" width="34" height="10" rx="3"/>
                <rect x="196" y="188" width="46" height="10" rx="3"/>
                <rect x="254" y="188" width="40" height="10" rx="3"/>
                <rect x="150" y="214" width="34" height="10" rx="3"/>
                <rect x="196" y="214" width="46" height="10" rx="3"/>
                <rect x="254" y="214" width="40" height="10" rx="3"/>
                <rect x="150" y="240" width="34" height="10" rx="3"/>
                <rect x="196" y="240" width="46" height="10" rx="3"/>
                <rect x="254" y="240" width="40" height="10" rx="3"/>
                <rect x="150" y="266" width="34" height="10" rx="3"/>
                <rect x="196" y="266" width="46" height="10" rx="3"/>
                <rect x="254" y="266" width="40" height="10" rx="3"/>
                <rect x="150" y="292" width="34" height="10" rx="3"/>
                <rect x="196" y="292" width="46" height="10" rx="3"/>
                <rect x="254" y="292" width="40" height="10" rx="3"/>
              </g>
            </g>

            <!-- reading scan sweep -->
            <rect class="scan" x="112" y="66" width="218" height="46" fill="url(#doc-scan)"/>
          </g>
        </g>

        <!-- morphing format seal (color + label cycle with the card) -->
        <g class="seal-badge">
          {formats.map((f, i) => (
            <g class={`badge b${i}`} style={`--d:${i * 4}s`}>
              <rect x="86" y="316" width="86" height="60" rx="16" fill={f.color}/>
              <rect x="86" y="316" width="86" height="60" rx="16" fill="#ffffff" opacity="0.08"/>
              <text x="129" y="352" text-anchor="middle" class="badge-tx">{f.ext}</text>
            </g>
          ))}
        </g>

        <!-- extracted answer chips -->
        <g class="answer a1">
          <rect x="250" y="352" width="150" height="40" rx="14" fill="#0e2140" stroke="#1f4f96"/>
          <circle cx="272" cy="372" r="9" fill="#2f9e58"/>
          <path d="M268 372l3 3 5-6" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          <text x="290" y="377" class="answer-tx">Table · 24 rows</text>
        </g>
        <g class="answer a2">
          <rect x="24" y="196" width="150" height="38" rx="14" fill="#0e2140" stroke="#1f4f96"/>
          <circle cx="46" cy="215" r="8" fill="#88b9ff"/>
          <path d="M42 215h8M46 211v8" stroke="#0e2140" stroke-width="2" stroke-linecap="round"/>
          <text x="62" y="220" class="answer-tx">Summary ready</text>
        </g>

        <!-- floating supported-format satellites -->
        {satellites.map((s) => (
          <g transform={`translate(${s.x} ${s.y})`}>
            <g class="sat" style={`--d:${s.d}`}>
              <path class="sat-page" d="M4 2 H30 L44 16 V54 a4 4 0 0 1 -4 4 H4 a4 4 0 0 1 -4 -4 V6 a4 4 0 0 1 4 -4 Z"/>
              <path class="sat-fold" d="M30 2 V16 H44 Z"/>
              <rect x="4" y="38" width="34" height="16" rx="4" fill={s.color}/>
              <text x="21" y="50" text-anchor="middle" class="sat-tx">{s.ext}</text>
            </g>
          </g>
        ))}
      </svg>
    </div>
  </div>
</section>

<style>
  .documents { overflow: hidden; padding-block: clamp(4.5rem, 9vw, 8rem); }
  .atmos { position: absolute; inset: 0; pointer-events: none; }
  .glow { position: absolute; width: 620px; height: 620px; left: -160px; bottom: -200px;
    background: radial-gradient(circle, #1746a0, transparent 68%); filter: blur(80px); opacity: 0.5; }
  .grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .copy > * + * { margin-top: 1.3rem; }
  .checks { list-style: none; padding: 0; display: grid; gap: 0.8rem; }
  .checks li { display: flex; align-items: center; gap: 0.75rem; font-weight: 500; }
  .section-link { display: inline-block; margin-top: 0.5rem; color: var(--blue-bright);
    font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  .visual { display: grid; place-items: center; }
  .doc-scene { width: min(460px, 92%); height: auto; overflow: visible; }

  /* depth */
  .ghosts rect { fill: #16273f; stroke: rgba(140,180,240,0.12); stroke-width: 1.5; }

  /* card */
  .doc-card .paper { fill: url(#doc-paper); }
  .doc-card .fold { fill: #cdd7e6; }
  .doc-card { animation: card-breathe 9s var(--ease) infinite; transform-origin: 220px 224px; }
  @keyframes card-breathe {
    0%, 100% { transform: rotate(-2deg) translateY(0); }
    50%      { transform: rotate(1.4deg) translateY(-8px); }
  }

  .ln { fill: #38506f; }
  .ln.lite { fill: #d4deec; }
  .xls-grid rect:not([fill]) { fill: #edf2f8; }
  .xls-grid rect { stroke: #d3ddea; stroke-width: 1; }
  .csv-rows rect:not([fill]) { fill: #cdd8e6; }

  /* format content crossfade — 16s loop, 4 slots of 4s */
  .fmt { opacity: 0; animation: fmt-cycle 16s var(--ease) infinite; animation-delay: calc(var(--d) * -1); }
  @keyframes fmt-cycle {
    0%   { opacity: 1; }
    22%  { opacity: 1; }
    25%  { opacity: 0; }
    97%  { opacity: 0; }
    100% { opacity: 1; }
  }

  /* format seal badge crossfades in sync */
  .badge { opacity: 0; animation: fmt-cycle 16s var(--ease) infinite; animation-delay: calc(var(--d) * -1); }
  .badge-tx { fill: #fff; font-family: var(--mono); font-weight: 700; font-size: 20px; letter-spacing: 0.02em; }

  /* scan */
  .scan { animation: scan-move 3.6s var(--ease) infinite; mix-blend-mode: screen; }
  @keyframes scan-move {
    0%   { transform: translateY(0);    opacity: 0; }
    12%  { opacity: 1; }
    88%  { opacity: 1; }
    100% { transform: translateY(272px); opacity: 0; }
  }

  /* answer chips */
  .answer-tx { fill: #dbe7fb; font-family: var(--sans); font-weight: 600; font-size: 15px; }
  .answer { animation: pop 16s var(--ease) infinite; transform-origin: center; }
  .answer.a1 { animation-delay: -4.6s; }
  .answer.a2 { animation-delay: -0.6s; }
  @keyframes pop {
    0%, 4%   { opacity: 0; transform: scale(0.6) translateY(10px); }
    10%      { opacity: 1; transform: scale(1) translateY(0); }
    22%      { opacity: 1; transform: scale(1) translateY(0); }
    28%, 100%{ opacity: 0; transform: scale(0.9) translateY(-4px); }
  }

  /* satellites */
  .sat-page { fill: #e9eef6; }
  .sat-fold { fill: #c7d2e0; }
  .sat-tx { fill: #fff; font-family: var(--mono); font-weight: 700; font-size: 11px; }
  .sat { animation: bob 6s var(--ease) infinite alternate; animation-delay: calc(var(--d) * -1); }
  @keyframes bob { to { transform: translateY(-12px); } }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; text-align: center; }
    .copy { display: flex; flex-direction: column; align-items: center; }
    .checks li { justify-content: center; text-align: left; }
    .visual { margin-top: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .doc-card, .fmt, .badge, .scan, .answer, .sat { animation: none; }
    .doc-card { transform: rotate(-2deg); }
    .fmt.f0, .badge.b0, .answer.a1 { opacity: 1; }
    .fmt.f1, .fmt.f2, .fmt.f3, .badge.b1, .badge.b2, .badge.b3, .answer.a2 { opacity: 0; }
    .scan { opacity: 0; }
  }
</style>

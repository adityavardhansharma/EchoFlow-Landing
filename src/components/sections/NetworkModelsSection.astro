---
import PhoneFrame from '../PhoneFrame.astro';
import Seal from '../Seal.astro';
---
<section id="network-models" class="paper network">
  <div class="wrap-wide grid">
    <div class="visual">
      <PhoneFrame tone="light" class="phone-ollama">
        <img src="/brand/v2/network-ollama.jpg" alt="EchoFlow custom API endpoints — Ollama server and OpenAI-compatible providers" loading="lazy" width="288" height="624" />
      </PhoneFrame>
      <PhoneFrame tone="light" class="phone-picker">
        <img src="/brand/v2/model-picker.jpg" alt="EchoFlow model picker showing cloud APIs and local network models" loading="lazy" width="288" height="624" />
      </PhoneFrame>
    </div>

    <div class="copy">
      <span class="kicker" style="color:var(--c-sunset)">Local &amp; network</span>
      <h2 class="h2">On-device, Ollama,<br />or your LAN.</h2>
      <p class="lead muted">
        One model picker for everything: frontier APIs, OpenRouter, GGUF models that run
        offline on your phone, and network endpoints like Ollama or LM Studio on your home server.
      </p>
      <ul class="checks">
        <li><Seal size={22} fill="var(--c-sunset)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg></Seal> <b>Local</b> badge for on-device GGUF models</li>
        <li><Seal size={22} fill="var(--c-sunset)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg></Seal> Connect <b>Ollama</b> &amp; OpenAI-compatible LAN servers</li>
        <li><Seal size={22} fill="var(--c-sunset)"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.4" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg></Seal> Search &amp; manage models from one sheet</li>
      </ul>
      <div class="links-row">
        <a href="/local-models">Local models →</a>
        <a href="/custom-endpoints">Custom endpoints →</a>
      </div>
    </div>
  </div>
</section>

<style>
  .network { padding-block: clamp(4.5rem, 9vw, 8rem); }
  .grid { display: grid; grid-template-columns: 0.85fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .copy > * + * { margin-top: 1.3rem; }
  .checks { list-style: none; padding: 0; display: grid; gap: 0.8rem; }
  .checks li { display: flex; align-items: center; gap: 0.75rem; font-weight: 500; }
  .links-row { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 0.5rem; }
  .links-row a { color: var(--blue); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .visual { position: relative; min-height: 520px; display: grid; place-items: center; }
  .visual :global(.phone) { position: absolute; }
  .visual :global(.phone-ollama) { width: 210px; transform: translate(28%, -6%) rotate(5deg); opacity: 0.96; z-index: 1; }
  .visual :global(.phone-picker) { width: 238px; transform: translate(-22%, 8%) rotate(-4deg); z-index: 2;
    filter: drop-shadow(0 40px 60px rgba(20,30,50,0.24)); }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .visual { order: -1; min-height: 560px; }
    .copy { text-align: center; display: flex; flex-direction: column; align-items: center; }
    .checks li { justify-content: center; text-align: left; }
    .links-row { justify-content: center; }
  }
</style>

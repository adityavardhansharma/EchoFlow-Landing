---
import PhoneFrame from './PhoneFrame.astro';
interface Props {
  title?: string;
  description?: string;
  poster?: string;
}
const {
  title = 'See EchoFlow in action',
  description = 'Watch how multi-model chat, model switching, web search and local storage work in the Android app.',
  poster = '/brand/app-demo-poster.jpg',
} = Astro.props;
---
<section class="video-showcase paper" id="demo-video">
  <div class="wrap-wide video-grid">
    <div class="video-copy">
      <span class="kicker" style="color:var(--blue)">App demo</span>
      <h2 class="h2">{title}</h2>
      <p class="muted">{description}</p>
    </div>
    <div class="video-visual">
      <PhoneFrame tone="dark" class="demo-phone">
        <video poster={poster} controls playsinline preload="metadata">
          <source src="/brand/app-demo.webm" type="video/webm" />
          <source src="/brand/app-demo.mp4" type="video/mp4" />
        </video>
      </PhoneFrame>
    </div>
  </div>
</section>

<style>
  .video-showcase { padding-block: clamp(3rem, 6vw, 5rem); border-top: 1px solid var(--line); }
  .video-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  .video-copy > * + * { margin-top: 1rem; }
  .video-visual { display: grid; place-items: center; }
  .demo-phone { width: min(280px, 80vw); filter: drop-shadow(0 30px 50px rgba(20,30,50,.25)); }
  .demo-phone video { width: 100%; height: auto; display: block; }
  @media (max-width: 820px) {
    .video-grid { grid-template-columns: 1fr; text-align: center; }
    .video-copy { display: flex; flex-direction: column; align-items: center; }
  }
</style>

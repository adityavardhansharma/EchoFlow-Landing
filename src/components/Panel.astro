---
import PhoneFrame from './PhoneFrame.astro';
import { flower } from '../lib/shapes';
/* v3 tour panel — one idea, one screenshot, one line. Each panel is a big
   rounded tonal surface tinted toward the accent of the screenshot it shows,
   so the page scrolls like the app's own theme picker. */
interface Props {
  id: string;
  num: string;          // "01"… stamped in the kicker chip
  kicker: string;
  title: string;
  body: string;         // may contain inline HTML
  facts?: string[];
  img?: string;
  alt?: string;
  tint?: string;        // CSS color the surface leans toward
  dark?: boolean;
  reverse?: boolean;
}
const {
  id, num, kicker, title, body,
  facts = [], img, alt = '',
  tint = 'var(--c-ocean)', dark = false, reverse = false,
} = Astro.props;
const stamp = flower(10, 50, 42);
---
<section class="panel-slot" id={id}>
  <article class:list={['panel', { dark, reverse }]} style={`--tint:${tint}`}>
    <svg class="stamp" viewBox="0 0 100 100" aria-hidden="true"><path d={stamp} /></svg>
    <div class="p-copy" data-reveal>
      <span class="chip p-chip"><b><span>{num}</span></b>{kicker}</span>
      <h2 class="h2">{title}</h2>
      <p class="p-body" set:html={body} />
      {facts.length > 0 && (
        <ul class="facts">
          {facts.map((f) => <li set:html={f} />)}
        </ul>
      )}
    </div>
    <div class="p-visual" data-reveal>
      <slot>
        {img && (
          <PhoneFrame tone={dark ? 'dark' : 'light'} class="p-phone">
            <img src={img} alt={alt} width="724" height="1568" loading="lazy" decoding="async" />
          </PhoneFrame>
        )}
      </slot>
    </div>
  </article>
</section>

<style>
  .panel-slot { padding-block: 0; }
  .panel {
    display: grid; grid-template-columns: 1.05fr .95fr; align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    border-radius: var(--r-xl);
    padding: clamp(1.8rem, 4.5vw, 4.2rem);
    background: color-mix(in oklab, var(--tint) 13%, var(--card));
    border: 1px solid color-mix(in oklab, var(--tint) 24%, transparent);
    overflow: hidden; position: relative;
  }
  .stamp { position: absolute; width: clamp(280px, 40%, 520px); z-index: 0;
    right: -8%; top: -22%; opacity: .5; pointer-events: none;
    fill: color-mix(in oklab, var(--tint) 10%, transparent); }
  .panel.reverse .stamp { right: auto; left: -8%; top: auto; bottom: -24%; }
  .dark .stamp { fill: color-mix(in oklab, var(--tint) 22%, transparent); opacity: .35; }
  .p-copy, .p-visual { position: relative; z-index: 1; }
  .panel.dark { background: var(--ink); border-color: var(--ink-2); color: var(--on-ink); }
  .panel.reverse .p-copy { order: 2; }
  .panel.reverse .p-visual { order: 1; }

  .p-copy > * + * { margin-top: 1.25rem; }
  .p-chip { color: color-mix(in oklab, var(--tint) 80%, var(--on-paper)); }
  .dark .p-chip { color: color-mix(in oklab, var(--tint) 55%, #fff); }
  .p-chip b span { color: var(--card); }
  .dark .p-chip b span { color: var(--ink); }
  .h2 { max-width: 14ch; }
  .p-body { font-size: clamp(1.02rem, 1.4vw, 1.18rem); line-height: 1.6;
    max-width: 46ch; color: var(--on-paper-soft); }
  .dark .p-body { color: var(--on-ink-soft); }
  .p-body :global(a) { color: color-mix(in oklab, var(--tint) 80%, var(--on-paper));
    font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }

  .facts { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .facts li {
    padding: .5rem .95rem; border-radius: var(--r-full);
    background: color-mix(in oklab, var(--tint) 16%, transparent);
    border: 1px solid color-mix(in oklab, var(--tint) 26%, transparent);
    font-size: .86rem; font-weight: 600;
    color: color-mix(in oklab, var(--tint) 62%, var(--on-paper));
  }
  .dark .facts li { color: color-mix(in oklab, var(--tint) 40%, #fff);
    background: color-mix(in oklab, var(--tint) 20%, transparent); }
  .facts li :global(b) { font-weight: 800; }

  .p-visual { display: grid; place-items: center; }
  .p-visual :global(.p-phone) { width: min(268px, 68vw);
    filter: drop-shadow(0 34px 60px rgba(46,42,24,.3)); }
  .dark .p-visual :global(.p-phone) { filter: drop-shadow(0 34px 60px rgba(0,0,0,.6)); }

  @media (max-width: 880px) {
    .panel { grid-template-columns: 1fr; }
    .panel.reverse .p-copy { order: 1; }
    .panel.reverse .p-visual { order: 2; }
    .p-visual { margin-top: 1.5rem; }
  }
</style>
---
import PhoneFrame from './PhoneFrame.astro';
import { flower } from '../lib/shapes';
/* One stop on the tour trail. Not a card: an open composition on the paper —
   copy on one side, visual on the other, a numbered flower node sitting on the
   dotted spine the .tour container draws down the middle. A soft tinted bloom
   sits behind the visual so each stop still carries its screenshot's color. */
interface Props {
  id: string;
  num: string;
  kicker: string;
  title: string;
  body: string;          // short. one or two sentences, may contain inline HTML
  list?: string[];       // optional flower-bullet lines (kept tiny)
  img?: string;
  alt?: string;
  tint?: string;
  darkShot?: boolean;    // phone frame tone for dark screenshots
  reverse?: boolean;
}
const {
  id, num, kicker, title, body, list = [], img, alt = '',
  tint = 'var(--c-ocean)', darkShot = false, reverse = false,
} = Astro.props;
const node = flower(8, 50, 46);
const bloom = flower(10, 50, 48);
---
<section class:list={['stop', { reverse }]} id={id} style={`--tint:${tint}`}>
  <div class="s-copy" data-reveal>
    <p class="s-kicker"><span class="s-num">{num}</span>{kicker}</p>
    <h2 class="s-title">{title}</h2>
    <p class="s-body" set:html={body} />
    {list.length > 0 && (
      <ul class="s-list">
        {list.map((f) => <li set:html={f} />)}
      </ul>
    )}
  </div>

  <div class="s-spine" aria-hidden="true">
    <span class="s-node">
      <svg viewBox="0 0 100 100"><path d={node} /></svg>
      <b>{num}</b>
    </span>
  </div>

  <div class="s-visual" data-reveal>
    <svg class="s-bloom" viewBox="0 0 100 100" aria-hidden="true"><path d={bloom} /></svg>
    <slot>
      {img && (
        <PhoneFrame tone={darkShot ? 'dark' : 'light'} class="s-phone">
          <img src={img} alt={alt} width="724" height="1568" loading="lazy" decoding="async" />
        </PhoneFrame>
      )}
    </slot>
  </div>
</section>

<style>
  .stop { display: grid; grid-template-columns: minmax(0, 1fr) 84px minmax(0, 1fr);
    align-items: center; column-gap: clamp(1rem, 3vw, 2.5rem); }
  .s-copy { grid-column: 1; grid-row: 1; }
  .s-spine { grid-column: 2; grid-row: 1; }
  .s-visual { grid-column: 3; grid-row: 1; }
  .stop.reverse .s-copy { grid-column: 3; }
  .stop.reverse .s-visual { grid-column: 1; }

  .s-copy { justify-self: end; text-align: right; max-width: 44ch; }
  .stop.reverse .s-copy { justify-self: start; text-align: left; }
  .s-copy > * + * { margin-top: 1.1rem; }

  .s-kicker { font-family: var(--mono); font-size: .78rem; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase;
    color: color-mix(in oklab, var(--tint) 78%, var(--on-paper)); }
  .s-num { display: none; }
  .s-title { font-family: var(--display); font-weight: 800; letter-spacing: -.025em;
    line-height: 1.0; font-size: clamp(2rem, 4vw, 3.4rem); }
  .s-body { font-size: clamp(1rem, 1.35vw, 1.16rem); line-height: 1.6;
    color: var(--on-paper-soft); }
  .s-body :global(b), .s-body :global(strong) {
    color: color-mix(in oklab, var(--tint) 70%, var(--on-paper)); }

  .s-list { list-style: none; padding: 0; display: grid; gap: .45rem;
    font-size: .93rem; font-weight: 600; color: var(--on-paper-soft); }
  .s-list li::before { content: '✿ '; color: var(--tint); }
  .stop:not(.reverse) .s-list li::before { content: none; }
  .stop:not(.reverse) .s-list li::after { content: ' ✿'; color: var(--tint); }
  .s-list :global(b) { color: var(--on-paper); font-weight: 700; }

  .s-spine { position: relative; height: 100%; min-height: 220px; }
  .s-node { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 58px; height: 58px; display: grid; place-items: center; }
  .s-node svg { position: absolute; inset: 0;
    fill: color-mix(in oklab, var(--tint) 16%, var(--paper));
    stroke: color-mix(in oklab, var(--tint) 55%, var(--paper)); stroke-width: 1.5; }
  .s-node b { position: relative; font-family: var(--mono); font-weight: 700;
    font-size: .82rem; color: color-mix(in oklab, var(--tint) 80%, var(--on-paper)); }

  .s-visual { position: relative; display: grid; place-items: center;
    padding-block: clamp(1rem, 2vw, 2rem); }
  .s-bloom { position: absolute; width: min(430px, 92%); z-index: 0;
    fill: color-mix(in oklab, var(--tint) 13%, var(--paper));
    animation: bloom-turn 120s linear infinite; }
  @keyframes bloom-turn { to { transform: rotate(360deg); } }
  .s-visual > :global(*:not(.s-bloom)) { position: relative; z-index: 1; }
  .s-visual :global(.s-phone) { width: min(258px, 66vw);
    filter: drop-shadow(0 30px 54px rgba(46,42,24,.32)); }

  @media (max-width: 880px) {
    .stop { grid-template-columns: 1fr; row-gap: .6rem; }
    .s-copy, .stop.reverse .s-copy { grid-column: 1; grid-row: 1;
      justify-self: start; text-align: left; max-width: none; }
    .stop:not(.reverse) .s-list li::after { content: none; }
    .stop:not(.reverse) .s-list li::before { content: '✿ '; color: var(--tint); }
    .s-spine { display: none; }
    .s-visual, .stop.reverse .s-visual { grid-column: 1; grid-row: 2; }
    .s-num { display: inline; margin-right: .6em; opacity: .6; }
  }
</style>

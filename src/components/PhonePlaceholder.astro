---
interface Props {
  label?: string;
}
const { label = 'Video placeholder' } = Astro.props;
---
<div class="ph-placeholder" aria-hidden="true">
  <span class="ph-grid"></span>
  <span class="ph-label">{label}</span>
</div>

<style>
  .ph-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(165deg, #1a2438 0%, #0d1524 55%, #121c2e 100%);
    position: relative;
    overflow: hidden;
  }
  .ph-grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 50% 38%, rgba(88, 145, 255, 0.14), transparent 52%),
      linear-gradient(rgba(140, 180, 240, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(140, 180, 240, 0.06) 1px, transparent 1px);
    background-size: auto, 24px 24px, 24px 24px;
  }
  .ph-label {
    position: relative;
    z-index: 1;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(180, 205, 240, 0.35);
    padding: 0.45rem 0.7rem;
    border: 1px dashed rgba(180, 205, 240, 0.2);
    border-radius: 999px;
  }
</style>

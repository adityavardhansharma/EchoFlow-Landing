---
import PhoneFrame from './PhoneFrame.astro';
import Seal from './Seal.astro';
import { flower } from '../lib/shapes';
const ring = flower(12, 50, 43);
const REPO = 'https://github.com/adityavardhansharma/EchoFlow';
---
<section id="top" class="hero dark">
  <div class="atmos" aria-hidden="true">
    <span class="glow g1"></span>
    <span class="glow g2"></span>
    <svg class="seal-bg" viewBox="0 0 100 100"><path d={ring} /></svg>
    <div class="grid-lines"></div>
  </div>

  <div class="wrap-wide hero-grid">
    <div class="hero-copy">
      <a
        class="ph-badge"
        href="https://www.producthunt.com/products/echoflow-2?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-echoflow-2"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="EchoFlow - Native Android AI chat with chats stored locally | Product Hunt"
          width="250"
          height="54"
          loading="eager"
          src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1161749&theme=neutral&t=1780564201227"
        />
      </a>
      <span class="kicker">A chat app for OpenRouter</span>
      <h1 class="display">
        Every model.<br /><span class="grad-blue">Made yours.</span>
      </h1>
      <p class="lead muted">
        Bring your OpenRouter key and talk to any model worth knowing. Every conversation
        lives on your phone — no account, and nothing is ever kept on a server.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/EchoFlow.apk" download>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.6 9.5 16 6.8a.4.4 0 0 0-.6-.1.4.4 0 0 0-.1.6L17 9.9A9.6 9.6 0 0 0 12 8.6a9.6 9.6 0 0 0-5 1.3l1.6-2.6a.4.4 0 0 0-.1-.6.4.4 0 0 0-.6.1L6.4 9.5A8 8 0 0 0 3 15.6h18a8 8 0 0 0-3.4-6.1ZM8 13.4a.8.8 0 1 1 .8-.8.8.8 0 0 1-.8.8Zm8 0a.8.8 0 1 1 .8-.8.8.8 0 0 1-.8.8Z"/></svg>
          Get it on Android
        </a>
        <a class="btn btn-outline-ink" href={REPO} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
          View on GitHub
        </a>
      </div>
      <ul class="hero-pills">
        <li><b>BYO</b> API key</li>
        <li><b>∞</b> models</li>
        <li><b>7</b> themes</li>
        <li><b>0</b> tracking</li>
      </ul>
    </div>

    <div class="hero-visual">
      <span class="hv-glow" aria-hidden="true"></span>
      <PhoneFrame tone="dark" class="hero-phone">
        <video
          src="/brand/app-demo.webm"
          poster="/brand/app-demo-poster.jpg"
          autoplay muted loop playsinline preload="auto"
        >
          <source src="/brand/app-demo.webm" type="video/webm" />
          <source src="/brand/app-demo.mp4" type="video/mp4" />
        </video>
      </PhoneFrame>
      <Seal size={58} logo fill="var(--blue-600)" class="hv-seal" />
    </div>
  </div>
</section>

<style>
  .hero { overflow: hidden; padding-top: clamp(2rem, 4vw, 3.4rem); padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .atmos { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .glow { position: absolute; border-radius: 50%; filter: blur(90px); opacity: .5; }
  .g1 { width: 620px; height: 620px; top: -260px; left: -140px;
    background: radial-gradient(circle, #1f6feb, transparent 64%); }
  .g2 { width: 560px; height: 560px; bottom: -280px; right: -120px;
    background: radial-gradient(circle, #123a78, transparent 64%); opacity: .65; }
  .seal-bg { position: absolute; width: 460px; right: -150px; top: 0; opacity: .05; }
  .seal-bg path { fill: var(--blue-bright); }
  .grid-lines { position: absolute; inset: 0;
    background-image: linear-gradient(var(--line-dark) 1px, transparent 1px),
                      linear-gradient(90deg, var(--line-dark) 1px, transparent 1px);
    background-size: 58px 58px; mask-image: radial-gradient(120% 80% at 50% 0%, #000, transparent 74%);
    opacity: .45; }

  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.1fr .9fr;
    gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; }
  .hero-copy > * + * { margin-top: 1.2rem; }
  .ph-badge { display: inline-block; line-height: 0; transition: transform .4s var(--spring); }
  .ph-badge:hover { transform: translateY(-2px); }
  .ph-badge img { width: 250px; height: 54px; }
  .display { font-size: clamp(2.7rem, 6.6vw, 5.4rem); text-wrap: balance; text-align: left; }
  .hero .lead { max-width: 44ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.7rem; }
  .hero-pills { list-style: none; padding: 1.3rem 0 0; display: flex; flex-wrap: wrap;
    gap: .4rem 1.7rem; margin-top: 1.6rem; border-top: 1px solid var(--line-dark);
    font-size: .9rem; color: var(--on-ink-soft); width: 100%; }
  .hero-pills b { font-family: var(--display); font-size: 1.2rem; color: var(--on-ink); margin-right: .35rem; font-weight: 800; }
  .hero-pills li { display: inline-flex; align-items: baseline; }

  .hero-visual { position: relative; display: grid; place-items: center; }
  .hv-glow { position: absolute; width: 115%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, rgba(31,111,235,.45), transparent 64%); filter: blur(50px); z-index: 0; }
  .hero-phone { width: min(300px, 78vw); position: relative; z-index: 1;
    filter: drop-shadow(0 50px 80px rgba(0,0,0,.55)); }
  .hv-seal { position: absolute; bottom: 4%; right: 6%; z-index: 2;
    filter: drop-shadow(0 12px 24px rgba(0,0,0,.45)); animation: bob 5s var(--ease) infinite alternate; }
  @keyframes bob { to { transform: translateY(-12px) rotate(-8deg); } }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-copy { align-items: center; }
    .display, .hero .lead { text-align: center; }
    .hero-cta, .hero-pills { justify-content: center; }
    .hero-pills { gap: .4rem 1.3rem; }
    .hero-visual { margin-top: 2.4rem; }
  }
</style>

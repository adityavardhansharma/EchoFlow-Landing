---
import PhoneFrame from './PhoneFrame.astro';
import { flower } from '../lib/shapes';
import { RELEASES_URL } from '../lib/releases';
const ring = flower(12, 50, 43);
const REPO = 'https://github.com/adityavardhansharma/EchoFlow';

/* Everything the model picker can point at, worn as a ticker. */
const ticker = [
  'GPT-5.6', 'Claude', 'Gemini', 'Grok', 'DeepSeek', 'Qwen', 'Sarvam 105B',
  'Gemma · on-device', 'Ollama', 'LM Studio', 'vLLM', 'OpenRouter · 400+ models',
];
---
<section id="top" class="hero">
  <svg class="seal-bg" viewBox="0 0 100 100" aria-hidden="true"><path d={ring} /></svg>

  <div class="wrap-wide hero-grid">
    <div class="hero-copy">
      <span class="chip hero-chip">Open source · Android · No account</span>
      <h1 class="display">
        Talk to any AI.<br /><em>Answer to no one.</em>
      </h1>
      <p class="lead muted">
        EchoFlow is an open-source AI workspace for Android. Bring your own keys —
        or no keys at all — and chat, search, dictate and create, with every word
        stored on your phone instead of someone's server.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={RELEASES_URL} data-apk rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.6 9.5 16 6.8a.4.4 0 0 0-.6-.1.4.4 0 0 0-.1.6L17 9.9A9.6 9.6 0 0 0 12 8.6a9.6 9.6 0 0 0-5 1.3l1.6-2.6a.4.4 0 0 0-.1-.6.4.4 0 0 0-.6.1L6.4 9.5A8 8 0 0 0 3 15.6h18a8 8 0 0 0-3.4-6.1ZM8 13.4a.8.8 0 1 1 .8-.8.8.8 0 0 1-.8.8Zm8 0a.8.8 0 1 1 .8-.8.8.8 0 0 1-.8.8Z"/></svg>
          Get the APK
        </a>
        <a class="btn btn-outline" href={REPO} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5Z"/></svg>
          Star on GitHub
        </a>
      </div>
      <a
        class="ph-badge"
        href="https://www.producthunt.com/products/echoflow-2?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-echoflow-2"
        target="_blank"
        rel="noopener noreferrer"
      >
        <img
          alt="EchoFlow - Native Android AI chat with chats stored locally | Product Hunt"
          width="250"
          height="54"
          loading="lazy"
          src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1161749&theme=neutral&t=1780564201227"
        />
      </a>
    </div>

    <div class="hero-visual">
      <svg class="hv-seal" viewBox="0 0 100 100" aria-hidden="true"><path d={ring} /></svg>
      <PhoneFrame tone="light" class="hero-phone">
        <img src="/brand/v3/02-chat-home-light-theme.jpg" alt="EchoFlow chat home screen" width="724" height="1568" loading="eager" fetchpriority="high" />
      </PhoneFrame>
      <span class="float-card fc-1">Web search — free, no key</span>
      <span class="float-card fc-2">Works fully offline</span>
      <span class="float-card fc-3">Chats never leave the phone</span>
    </div>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[0, 1].map(() => (
        <ul>
          {ticker.map((t) => <li>{t}</li>)}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { overflow: hidden; padding-top: clamp(3rem, 7vw, 5.5rem); padding-bottom: 0; }
  .seal-bg { position: absolute; width: min(720px, 70vw); right: -12%; top: -18%;
    opacity: .5; pointer-events: none; }
  .seal-bg path { fill: var(--paper-2); }

  .hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.15fr .85fr;
    gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; }
  .hero-copy > * + * { margin-top: 1.35rem; }
  .hero-chip { color: var(--olive); background: color-mix(in oklab, var(--butter) 45%, transparent); padding: .5rem 1.1rem; }
  .display em { font-style: normal; color: var(--blue); }
  .hero .lead { max-width: 46ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.9rem; }
  .ph-badge { display: inline-block; line-height: 0; margin-top: 2rem; opacity: .85;
    transition: transform .4s var(--spring), opacity .2s; }
  .ph-badge:hover { transform: translateY(-2px); opacity: 1; }
  .ph-badge img { width: 220px; height: 48px; }

  .hero-visual { position: relative; display: grid; place-items: center; padding-block: 1rem; }
  .hv-seal { position: absolute; width: 118%; max-width: 520px; z-index: 0;
    animation: turn 90s linear infinite; }
  .hv-seal path { fill: color-mix(in oklab, var(--blue) 14%, var(--paper)); }
  @keyframes turn { to { transform: rotate(360deg); } }
  .hero-visual :global(.hero-phone) { width: min(292px, 74vw); position: relative; z-index: 1;
    transform: rotate(2.5deg);
    filter: drop-shadow(0 44px 70px rgba(46,42,24,.36)); }

  .float-card { position: absolute; z-index: 2; padding: .6rem 1rem; border-radius: var(--r-full);
    background: var(--card); border: 1px solid var(--line);
    box-shadow: 0 16px 34px -20px rgba(46,42,24,.5);
    font-weight: 600; font-size: .84rem; white-space: nowrap;
    animation: bob 6s var(--ease) infinite alternate; }
  .fc-1 { top: 12%; left: -2%; color: var(--olive); animation-delay: -1.5s; }
  .fc-2 { top: 46%; right: -4%; color: var(--blue); animation-delay: -3s; }
  .fc-3 { bottom: 9%; left: 2%; color: var(--c-rose); }
  @keyframes bob { to { transform: translateY(-10px); } }

  .ticker { margin-top: clamp(2.5rem, 5vw, 4rem); border-block: 1px solid var(--line);
    padding-block: .9rem; overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .ticker-track { display: flex; width: max-content; animation: ticker 36s linear infinite; }
  .ticker ul { list-style: none; padding: 0; display: flex; }
  .ticker li { font-family: var(--display); font-weight: 700; font-size: 1.05rem;
    letter-spacing: -.01em; color: var(--on-paper-soft); white-space: nowrap; padding-right: 1.2rem; }
  .ticker li::after { content: '✿'; margin-left: 1.2rem; color: var(--line); font-size: .8em; }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-copy { align-items: center; text-align: center; }
    .hero .lead { text-align: center; }
    .hero-cta { justify-content: center; }
    .hero-visual { margin-top: 2.2rem; }
    .fc-1 { left: 4%; } .fc-2 { right: 2%; } .fc-3 { left: 8%; }
  }
</style>

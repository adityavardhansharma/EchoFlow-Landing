---
/* Footer — the last two rows of a board: filled tiles, every cell used.
   The upper row carries the facts and every deep page; the lower row is the
   wordmark at full width and the one action, once more. */
import { alternativeLinks, featureLinks, guideLinks } from '../../lib/navigation';
import { RELEASES_URL } from '../../lib/releases';

const year = new Date().getFullYear();
---
<footer class="tf" aria-labelledby="tf-title">
  <h2 id="tf-title" class="sr-only">EchoFlow</h2>

  <div class="t t-statement" data-reveal style="--i:0">
    <p class="t-big">An open-source AI workspace for Android. Your models, your keys, your phone.</p>
    <p class="t-legal">© {year} EchoFlow · MIT licence. Not affiliated with OpenRouter or any model provider.</p>
  </div>

  <nav class="t t-nav" data-reveal style="--i:1" aria-label="Features">
    <p class="t-head">Features</p>
    <ul>
      {featureLinks.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>

  <nav class="t t-compare" data-reveal style="--i:2" aria-label="Compare">
    <p class="t-head">Compare</p>
    <ul>
      {alternativeLinks.map((l) => <li><a class="link" href={l.href}>{l.label.replace(' alternative', '')}</a></li>)}
    </ul>
  </nav>

  <div class="t t-contact" data-reveal style="--i:3">
    <p class="t-head">Guides and help</p>
    <ul>
      {guideLinks.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}
    </ul>
    <a class="t-mail link" href="mailto:echoflow@adityavs.tech">echoflow@adityavs.tech</a>
  </div>

  <a class="t t-word" data-reveal href="https://github.com/adityavardhansharma/EchoFlow" target="_blank" rel="noopener" aria-label="EchoFlow on GitHub">
    <span aria-hidden="true">EchoFlow</span>
  </a>

  <a class="t t-go" data-reveal style="--i:1" href={RELEASES_URL} data-apk>
    <span class="t-go-text">Get the APK</span>
    <svg viewBox="0 0 48 48" width="56" height="56" aria-hidden="true">
      <path d="M12 36 36 12M16 12h20v20" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="square" />
    </svg>
  </a>
</footer>

<style>
  .tf {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 8px;
    padding: 8px var(--margin) var(--margin);
    background: var(--accent);
    transition: background-color var(--t-repaint) ease;
  }
  .t {
    min-height: 220px; padding: 24px; background: var(--bg); color: var(--ink);
    display: flex; flex-direction: column; justify-content: space-between; gap: 1rem;
    transition: background-color var(--t-repaint) ease, color var(--t-repaint) ease;
  }
  .t-statement { grid-column: 1 / 5; }
  .t-nav { grid-column: 5 / 8; justify-content: flex-start; }
  .t-compare { grid-column: 8 / 10; justify-content: flex-start; }
  .t-contact { grid-column: 10 / 13; }
  .t-big { font-size: 1.5rem; line-height: 1.2; font-weight: 600; letter-spacing: -0.02em; max-width: 24ch; }
  .t-legal { font-size: var(--step-small); color: var(--muted); }
  .t-head { font-size: var(--step-small); color: var(--muted); font-weight: 600; }
  .t ul { display: grid; gap: 4px; font-size: 1rem; list-style: none; padding: 0; margin: 0; }
  .t-nav ul { grid-template-columns: 1fr 1fr; column-gap: 1rem; }
  .t-mail { font-size: 1.25rem; overflow-wrap: anywhere; }

  .t-word {
    grid-column: 1 / 9; min-height: 320px; background: var(--ink); color: var(--bg);
    display: grid; place-items: center; text-decoration: none; overflow: hidden;
  }
  .t-word span {
    font-family: var(--font-display); font-weight: 800; font-size: 11vw;
    letter-spacing: -0.06em; line-height: 0.85; white-space: nowrap;
    transition: transform 900ms var(--ease-expo);
  }
  .t-go {
    grid-column: 9 / 13; min-height: 320px;
    background: var(--surface); color: var(--ink); text-decoration: none;
  }
  .t-go-text { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.03em; }
  .t-go svg { align-self: flex-end; transition: transform var(--t-ui) var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .t-go:hover svg { transform: translate(6px, -6px); }
    .t-word:hover span { transform: scale(1.03); }
  }

  @media (max-width: 60em) {
    .tf { grid-template-columns: 1fr 1fr; gap: 6px; padding-top: 6px; }
    .t { padding: 20px; min-height: 0; }
    .t-word { grid-column: 1 / -1; grid-row: 1; min-height: 160px; }
    .t-word span { font-size: 19vw; }
    .t-go { grid-column: 1 / -1; grid-row: 2; min-height: 160px; }
    .t-nav { grid-column: 1 / -1; }
    .t-compare, .t-contact { grid-column: span 1; }
    .t-statement { grid-column: 1 / -1; }
  }
</style>

---
import { flower } from '../lib/shapes';
/* The scalloped "seal" badge that stamps every icon button in the EchoFlow app.
   Used here as a recurring brand motif. Pass a slot for inner content (logo,
   icon, number), or `logo` to drop in the EchoFlow mark. */
interface Props {
  size?: number;
  petals?: number;
  fill?: string;       // CSS color for the badge
  logo?: boolean;
  class?: string;
}
const { size = 64, petals = 12, fill = 'var(--blue)', logo = false, class: klass = '' } = Astro.props;
const d = flower(petals, 50, 43);
---
<span class:list={['seal', klass]} style={`--sz:${size}px; --fill:${fill}`}>
  <svg viewBox="0 0 100 100" aria-hidden="true"><path d={d} /></svg>
  <span class="seal-in">
    {logo ? <img src="/brand/echoflow-mark.png" alt="" /> : <slot />}
  </span>
</span>

<style>
  .seal { position: relative; display: inline-grid; place-items: center; width: var(--sz); height: var(--sz); flex: none; }
  .seal > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .seal > svg path { fill: var(--fill); }
  .seal-in { position: relative; display: grid; place-items: center; width: 58%; height: 58%; color: #fff; }
  .seal-in img { width: 100%; height: 100%; object-fit: contain; }
  .seal-in :global(svg) { width: 100%; height: 100%; }
</style>
